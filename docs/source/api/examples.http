POST {{host}}api/v1/accounts/logout/ HTTP/1.1
Content-Type: application/vnd.api+json
Referer: {{host}}api/v1/accounts/logout/
X-CSRFToken: {{csrf_token}}

{
  "data": {
    "type": "Logout"
  }
}