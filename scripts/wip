#!/usr/bin/env python3
"""wip: GitHub claim board for parallel OpenCode clients.

Maintainer tool carried by this repository; run it as `scripts/wip` from the
repository root. It needs an authenticated `gh` for the current user on the
host and keeps "which client works on which issue" in GitHub itself instead
of agent context windows. Claims live as one machine-readable comment per
issue per client, plus the "status: wip" label for fast discovery, plus a
pinned "Agent Work Board" issue listing all active claims.

Usage:
  scripts/wip claim [N]  claim the issue for the current worktree (idempotent:
                         running again refreshes the heartbeat and marks a
                         waiting claim as running again). Refuses while
                         another client holds a fresh claim; --force takes a
                         foreign or stale claim over deliberately.
  scripts/wip ask "<q>"  post the full question as one structured comment on the
           [--issue N]   issue and run the wait flow with a one-line summary;
                         idempotent per client while the question is open
  scripts/wip answers    show the current client's open questions and the human
           [--issue N]   replies to them, marking an answered question so it is
                         not surfaced twice
  scripts/wip wait "<q>" mark the active claim as blocked on user input, with
                         the reason; the board lists it under "Needs user"
  scripts/wip done  [N]  release your claim on the issue
  scripts/wip ls         overview: local worktrees + remote claims, reads only
  scripts/wip board      create the pinned Agent Work Board issue, rebuild its body

claim, wait and done rebuild the board themselves on their way out, so it moves
with every claim change; `wip board` is only needed to create the issue the first
time or to rebuild it after a refresh that failed. Board and label are generated
views, the claim comments are the truth.

Client identity: <hostname>:<worktree-dir-name>, override with CLIENT_TAG.
Issue number: inferred from a branch name containing issue-<N> (or #<N>),
or passed explicitly. A claim whose heartbeat is older than WIP_STALE_DAYS
(default 3) is flagged as stale on the board.
"""

import json
import os
import re
import socket
import subprocess
import sys
from datetime import datetime, timezone

LABEL = "status: wip"
LABEL_DESC = "actively worked on by a client - see the claim comment on the issue"
LABEL_COLOR = "6f42c1"
BOARD_TITLE = "Agent Work Board (machine-managed - do not close)"
BOARD_MARK = "agent-board v1"
CLAIM_RE = re.compile(r"<!-- agent-claim (\{.*?\}) -->")
QUESTION_RE = re.compile(r"<!-- agent-question client=(\S+) id=(\S+) -->")
ANSWERED_MARK = "agent-question-answered"
STALE_DAYS = float(os.environ.get("WIP_STALE_DAYS", "3"))


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s):
    try:
        return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None


def age_short(s):
    dt = parse_iso(s)
    if not dt:
        return "?"
    secs = (datetime.now(timezone.utc) - dt).total_seconds()
    if secs < 90:
        return "now"
    if secs < 5400:
        return f"{int(secs // 60)}m"
    if secs < 172800:
        return f"{int(secs // 3600)}h"
    return f"{int(secs // 86400)}d"


def is_stale(p):
    dt = parse_iso(p.get("heartbeat") or p.get("since"))
    if not dt:
        return False
    return (datetime.now(timezone.utc) - dt).days >= STALE_DAYS


def die(msg):
    sys.stderr.write(f"wip: {msg}\n")
    sys.exit(1)


def sh(cmd, input=None, check=True):
    r = subprocess.run(cmd, input=input, capture_output=True, text=True)
    if check and r.returncode != 0:
        die("command failed: %s\n%s" % (" ".join(cmd[:4]), (r.stderr or "").strip()))
    return (r.stdout or "").strip()


def gh_json(*args):
    out = sh(["gh"] + list(args))
    return json.loads(out) if out else None


def try_sh(cmd, input=None):
    """Best-effort command: True on success, False with the reason on stderr.

    For the writes that follow a claim, which must not decide its exit code.
    """
    r = subprocess.run(cmd, input=input, capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(f"wip: {' '.join(cmd[:4])}: {(r.stderr or '').strip()}\n")
    return r.returncode == 0


def repo():
    return sh(["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"])


def git_root():
    return sh(["git", "rev-parse", "--show-toplevel"])


def cur_branch():
    return sh(["git", "rev-parse", "--abbrev-ref", "HEAD"])


def client_id(root):
    return os.environ.get("CLIENT_TAG") or (
        socket.gethostname().split(".")[0] + ":" + os.path.basename(root)
    )


def local_host():
    return socket.gethostname().split(".")[0]


def infer_issue(explicit, cmd):
    if explicit:
        if re.fullmatch(r"#?\d+", explicit):
            return int(explicit.lstrip("#"))
        die(f"'{explicit}' is not an issue number")
    b = cur_branch()
    m = re.search(r"issue[-_]?(\d+)", b) or re.search(r"#(\d+)", b)
    if m:
        return int(m.group(1))
    die(f"cannot infer issue number from branch '{b}' - run: wip {cmd} <N>")


def issue_url(R, n):
    return f"https://github.com/{R}/issues/{n}"


def fetch_comments(R, n):
    out = sh(["gh", "api", f"repos/{R}/issues/{n}/comments", "--paginate"])
    return json.loads(out) if out else []


def unquoted_lines(body):
    """The lines that are not part of a GitHub quote block."""
    return [l for l in body.splitlines() if not l.lstrip().startswith(">")]


def unquoted_match(rx, body):
    """First match of a marker regex on an unquoted line.

    A human who answers with "Reply in conversation" quotes the machine comment,
    so its marker text appears inside '>' lines. That repeats the text, it does
    not repeat the comment: a marker only counts where it stands on its own.
    """
    for line in unquoted_lines(body):
        m = rx.search(line)
        if m:
            return m
    return None


def claim_payloads(comments):
    """[(comment_id, payload)] newest-last, for all claim comments."""
    found = []
    for c in comments:
        m = unquoted_match(CLAIM_RE, c.get("body") or "")
        if not m:
            continue
        try:
            p = json.loads(m.group(1))
        except ValueError:
            continue
        found.append((c["id"], p))
    return found


def active_claims(payloads):
    return [p for _, p in payloads if p.get("state") in ("wip", "waiting")]


def claim_body(p):
    marker = "<!-- agent-claim %s -->" % json.dumps(p, separators=(",", ":"))
    if p.get("state") == "wip":
        head = f"🚧 **WIP** — claimed by `{p['client']}`"
        extra = ""
        tail = f"last heartbeat: {p['heartbeat']} ({age_short(p['heartbeat'])} ago)"
    elif p.get("state") == "waiting":
        head = f"⏸ **Needs user input** — claimed by `{p['client']}`"
        extra = f"- waiting for: {p.get('question', 'input')}\n"
        tail = f"last heartbeat: {p['heartbeat']} ({age_short(p['heartbeat'])} ago)"
    else:
        head = f"✅ **Released** — was claimed by `{p['client']}`"
        extra = ""
        tail = f"released: {p.get('released', p['heartbeat'])}"
    return (
        f"{marker}\n\n{head}\n\n"
        f"- branch: `{p['branch']}`\n"
        f"- worktree: `{p['worktree']}`\n"
        f"- since: {p['since']}\n"
        f"{extra}"
        f"- {tail}\n"
    )


def question_body(cid, qid, question):
    """A question comment: one machine-readable marker plus the full question."""
    marker = f"<!-- agent-question client={cid} id={qid} -->"
    return (
        f"{marker}\n\n"
        f"🙋 **Question for the user** — asked by `{cid}` (id `{qid}`)\n\n"
        f"{question}\n"
    )


def answered_body(body, ts):
    """Re-mark a question comment as answered, so its reply is not shown twice."""
    return body.rstrip() + f"\n\n<!-- {ANSWERED_MARK} {ts} -->\n"


def question_markers(comments):
    """[(comment_id, client, id, answered, created_at, body)] newest-last, for question comments."""
    found = []
    for c in comments:
        body = c.get("body") or ""
        m = unquoted_match(QUESTION_RE, body)
        if not m:
            continue
        found.append((c["id"], m.group(1), m.group(2),
                      any(ANSWERED_MARK in l for l in unquoted_lines(body)),
                      c.get("created_at") or "", body))
    return found


def is_machine_comment(c):
    """Claim, question and board comments are generated views, not human answers.

    Only markers on unquoted lines mark a comment as machine-managed: a quote-reply
    to a question carries the question's marker text inside '>' lines and is exactly
    the human answer `answers` has to surface.
    """
    body = c.get("body") or ""
    return (bool(unquoted_match(CLAIM_RE, body)) or bool(unquoted_match(QUESTION_RE, body))
            or any(BOARD_MARK in l for l in unquoted_lines(body)))


def summarize(question, limit=72):
    line = " ".join(question.split())
    return line if len(line) <= limit else line[:limit].rstrip() + "..."


def ensure_label(R):
    names = [l["name"] for l in (gh_json("label", "list", "-R", R, "--limit", "300", "--json", "name") or [])]
    if LABEL not in names:
        sh(["gh", "label", "create", LABEL, "-R", R, "--color", LABEL_COLOR, "--description", LABEL_DESC])


def add_wip_label(R, n):
    """Label the claim, and name it when the write fails instead of swallowing it.

    The claim comment stays authoritative, so a failure only warns - but it has to
    say what it costs: `wip board` discovers claims by this label, so a claim
    without it is invisible there while `wip ls` still shows it.
    """
    ensure_label(R)
    if not try_sh(["gh", "issue", "edit", str(n), "-R", R, "--add-label", LABEL]):
        sys.stderr.write(f"wip: warning: the claim on #{n} stands, but `{LABEL}` did not "
                         f"apply, and the board scans by label and will miss it\n")


def claims_index(R, numbers):
    """{issue: payloads} for the given issue numbers."""
    idx = {}
    for n in numbers:
        idx[n] = claim_payloads(fetch_comments(R, n))
    return idx


def labeled_issues(R):
    items = gh_json("issue", "list", "-R", R, "--state", "open", "--label", LABEL,
                    "--limit", "200", "--json", "number,title") or []
    return {i["number"]: i["title"] for i in items}


def worktrees():
    raw = sh(["git", "worktree", "list", "--porcelain"])
    trees, cur = [], {}
    for line in raw.splitlines():
        if line.startswith("worktree "):
            cur = {"path": line[9:]}
        elif line.startswith("branch "):
            cur["branch"] = line[7:].replace("refs/heads/", "")
        elif not line.strip():
            if cur.get("path"):
                trees.append(cur)
            cur = {}
    if cur.get("path"):
        trees.append(cur)
    return trees


# ---------- commands ----------

def guard_others(payloads, cid, n, cmd, force):
    """Refuse to join an issue a live other client works on; warn past stale ones."""
    others = [c for c in active_claims(payloads) if c.get("client") != cid]
    fresh = [c for c in others if not is_stale(c)]
    if fresh:
        h = fresh[0]
        waiting = f" and waits for user input: {h.get('question', 'input')}" if h.get("state") == "waiting" else ""
        die(f"issue #{n} is claimed by `{h['client']}` on branch `{h['branch']}` "
            f"(heartbeat {age_short(h['heartbeat'])} ago){waiting}; "
            f"check `wip ls`, pick another issue, or take over deliberately with `wip {cmd} --force`")
    for h in [c for c in others if is_stale(c)]:
        sys.stderr.write(f"wip: warning: joining issue #{n} despite stale claim by "
                         f"`{h['client']}` (heartbeat {age_short(h['heartbeat'])} ago)\n")


def cmd_claim(arg, force=False):
    R, root = repo(), git_root()
    cid = client_id(root)
    n = infer_issue(arg, "claim")
    payloads = claim_payloads(fetch_comments(R, n))
    own = [(i, p) for i, p in payloads if p.get("client") == cid]
    own_active = any(p.get("state") in ("wip", "waiting") for _, p in own)
    if not own_active:
        guard_others(payloads, cid, n, "claim", force)
    last = own[-1] if own else None
    ts = now_iso()
    if last and last[1].get("state") in ("wip", "waiting"):
        was_waiting = last[1].get("state") == "waiting"
        p = dict(last[1])
        p["state"] = "wip"
        p.pop("question", None)
        p["heartbeat"] = ts
        p["branch"], p["worktree"] = cur_branch(), root
        sh(["gh", "api", "-X", "PATCH", f"repos/{R}/issues/comments/{last[0]}", "-f", f"body={claim_body(p)}"])
        action = "resumed claim on" if was_waiting else "heartbeat on claim to"
    else:
        p = {"v": 1, "client": cid, "issue": n, "branch": cur_branch(), "worktree": root,
             "state": "wip", "since": ts, "heartbeat": ts, "released": None}
        sh(["gh", "api", f"repos/{R}/issues/{n}/comments", "-f", f"body={claim_body(p)}"])
        action = "claimed"
    add_wip_label(R, n)
    print(f"{action} #{n} as `{cid}` -> {issue_url(R, n)}")
    sync_board(R)


def cmd_done(arg):
    R, root = repo(), git_root()
    cid = client_id(root)
    n = infer_issue(arg, "done")
    payloads = claim_payloads(fetch_comments(R, n))
    own = [(i, p) for i, p in payloads if p.get("client") == cid and p.get("state") in ("wip", "waiting")]
    if not own:
        print(f"no active claim for `{cid}` on #{n}")
        return
    cid_c, p = own[-1]
    p = dict(p)
    p["state"], p["released"], p["heartbeat"] = "done", now_iso(), now_iso()
    sh(["gh", "api", "-X", "PATCH", f"repos/{R}/issues/comments/{cid_c}", "-f", f"body={claim_body(p)}"])
    if not active_claims(payloads_after := [x for x in payloads if x[0] != cid_c]):
        sh(["gh", "issue", "edit", str(n), "-R", R, "--remove-label", LABEL], check=False)
    print(f"released #{n} for `{cid}` -> {issue_url(R, n)}")
    sync_board(R)


def cmd_wait(reason, force=False, issue=None):
    if not reason:
        die('usage: wip wait "<what you need from the user>"')
    R, root = repo(), git_root()
    cid = client_id(root)
    n = infer_issue(issue, "wait")
    payloads = claim_payloads(fetch_comments(R, n))
    own = [(i, p) for i, p in payloads if p.get("client") == cid and p.get("state") in ("wip", "waiting")]
    ts = now_iso()
    if own:
        c_id, p = own[-1]
        p = dict(p)
        p["state"], p["question"], p["heartbeat"] = "waiting", reason, ts
        sh(["gh", "api", "-X", "PATCH", f"repos/{R}/issues/comments/{c_id}", "-f", f"body={claim_body(p)}"])
        action = "marked waiting for user input on"
    else:
        guard_others(payloads, cid, n, "wait", force)
        p = {"v": 1, "client": cid, "issue": n, "branch": cur_branch(), "worktree": root,
             "state": "waiting", "question": reason, "since": ts, "heartbeat": ts, "released": None}
        sh(["gh", "api", f"repos/{R}/issues/{n}/comments", "-f", f"body={claim_body(p)}"])
        action = "claimed and marked waiting for user input on"
    add_wip_label(R, n)
    print(f"{action} #{n} as `{cid}` -> {issue_url(R, n)}")
    sync_board(R)


def cmd_ask(question, issue_arg=None, force=False):
    """Hand a full question to the issue, then mark the claim as waiting on it.

    One structured question comment per client: re-running `ask` while a question
    is still open updates that comment instead of stacking a second one. The board
    only ever shows the one-line summary; the comment carries the whole question.
    """
    if not question:
        die('usage: wip ask "<what you need from the user>" [--issue N]')
    R, root = repo(), git_root()
    cid = client_id(root)
    n = infer_issue(issue_arg, "ask")
    open_q = [q for q in question_markers(fetch_comments(R, n))
              if q[1] == cid and not q[3]]
    if open_q:
        q_id, _, qid, _, _, _ = open_q[-1]
        sh(["gh", "api", "-X", "PATCH", f"repos/{R}/issues/comments/{q_id}",
            "-f", f"body={question_body(cid, qid, question)}"])
        action = f"refreshed open question {qid} on"
    else:
        qid = os.urandom(4).hex()
        sh(["gh", "api", f"repos/{R}/issues/{n}/comments",
            "-f", f"body={question_body(cid, qid, question)}"])
        action = f"asked ({qid}) on"
    print(f"{action} #{n} as `{cid}` -> {issue_url(R, n)}")
    cmd_wait(summarize(question), force, str(n))


def cmd_answers(issue_arg=None):
    """Print this client's open questions and the human replies to them.

    A reply is any comment newer than the question that is not machine-managed
    (claim, question, board), a quote-reply to the question included. Once a
    question has a reply it is stamped answered, on the original question comment,
    so a later run - or a fresh `ask` - does not surface the same answer again.
    """
    R, root = repo(), git_root()
    cid = client_id(root)
    n = infer_issue(issue_arg, "answers")
    comments = fetch_comments(R, n)
    first = {}
    for q in question_markers(comments):
        if q[1] == cid and not q[3] and q[2] not in first:
            first[q[2]] = q  # the oldest comment of this id is the question itself
    open_q = list(first.values())
    if not open_q:
        print(f"no open questions for `{cid}` on #{n}")
        return
    print(f"open questions for `{cid}` on #{n}:")
    ts = now_iso()
    for q_id, _, qid, _, created, body in open_q:
        key = (created, q_id)
        replies = [c for c in comments
                   if not is_machine_comment(c) and ((c.get("created_at") or ""), c["id"]) > key]
        if not replies:
            print(f"\n- question {qid} ({age_short(created)} ago): still waiting for an answer")
            continue
        print(f"\n- question {qid} ({age_short(created)} ago): {len(replies)} answer(s)")
        for c in replies:
            who = (c.get("user") or {}).get("login", "?")
            print(f"    {who}: " + "\n      ".join((c.get("body") or "").strip().splitlines()))
        sh(["gh", "api", "-X", "PATCH", f"repos/{R}/issues/comments/{q_id}",
            "-f", f"body={answered_body(body, ts)}"])


def cmd_ls(_arg):
    R, root = repo(), git_root()
    cid, host = client_id(root), local_host()
    trees = worktrees()
    wt_issues = {}
    for t in trees:
        m = re.search(r"issue[-_]?(\d+)", t.get("branch", ""))
        t["issue"] = int(m.group(1)) if m else None
        if t["issue"]:
            wt_issues[t["issue"]] = f"local:{t['branch']}"
    labeled = labeled_issues(R)
    scan = dict(labeled)
    scan.update({n: "" for n in wt_issues})
    idx = claims_index(R, sorted(scan))

    print(f"repo: {R}   me: `{cid}`\n")
    print("LOCAL WORKTREES")
    hdr = f"{'':2}{'branch':46}{'issue':8}{'claims':60}"
    print(hdr)
    for t in trees:
        mark = "*" if t["path"] == root else " "
        n = t.get("issue")
        claims = active_claims(idx.get(n, [])) if n else []
        txt = ", ".join(
            ("me " if c["client"] == cid else "") + c["client"].split(":", 1)[0] +
            (" ⏸" if c.get("state") == "waiting" else "") +
            (" ⚠️" if is_stale(c) else "")
            for c in claims) or ("-" if n else "(no issue in branch)")
        print(f"{mark:2}{t.get('branch','(detached)'):46}{'#' + str(n) if n else '-':8}{txt:60}")

    remote = []
    for n, payloads in sorted(idx.items()):
        for c in active_claims(payloads):
            if c["client"] == cid or c["client"].split(":", 1)[0] == host:
                continue
            remote.append((n, c))
    print("\nREMOTE CLAIMS (other machines)")
    if not remote:
        print("  none")
    for n, c in remote:
        wait = " ⏸ NEEDS USER" if c.get("state") == "waiting" else ""
        print(f"  #{n:<5} {c['client']:30} {c['branch']:50} hb {age_short(c['heartbeat'])} ago{wait}{' ⚠️ STALE' if is_stale(c) else ''}")

    orphans = [n for n, payloads in sorted(idx.items())
               if n in labeled and not active_claims(payloads)]
    if orphans:
        print("\nLABELED WITHOUT CLAIM (label cleanup candidates)")
        for n in orphans:
            print(f"  #{n} {issue_url(R, n)}")


def board_body(R, rows, orphans):
    lines = [
        f"<!-- {BOARD_MARK} -->",
        "Machine-managed overview of which client works on which issue.",
        "Regenerated by `wip board` from claim comments — do not edit by hand.",
        "Claim with `wip claim` inside a worktree, release with `wip done`.",
        "A client blocked on a human marks itself with `wip wait \"<what you need>\"`",
        "and is listed first under *Needs user*.",
        "",
    ]
    if rows:
        lines += ["| Issue | Title | Client | Needs user | Branch | Worktree | Since | Last heartbeat |",
                  "|---|---|---|---|---|---|---|---|"]
        for n, title, c in rows:
            t = (title or "").replace("|", "\\|")[:80]
            flag = " ⚠️ STALE" if is_stale(c) else ""
            need = ("⏸ " + str(c.get("question", "input")).replace("|", "\\|"))[:60] \
                if c.get("state") == "waiting" else ""
            lines.append(
                f"| [#{n}]({issue_url(R, n)}) | {t} | `{c['client']}` | {need} | `{c['branch']}` | "
                f"`{c['worktree']}` | {c['since'][:10]} | {age_short(c['heartbeat'])} ago{flag} |")
    else:
        lines.append("_No active claims._")
    if orphans:
        lines += ["", "## Labeled without active claim (stale labels)", ""]
        lines += [f"- #{n} {issue_url(R, n)}" for n in orphans]
    lines += ["", f"_Refreshed {now_iso()} by `wip` on `{local_host()}`._"]
    return "\n".join(lines) + "\n"


def release_claims_on_closed(R):
    """Release claims that are still active on issues closed since the claim;
    closed work is finished work, no client should keep an active claim."""
    closed = gh_json("issue", "list", "-R", R, "--state", "closed", "--label", LABEL,
                     "--limit", "100", "--json", "number") or []
    count = 0
    for i in closed:
        payloads = claim_payloads(fetch_comments(R, i["number"]))
        here = 0
        for c_id, p in payloads:
            if p.get("state") not in ("wip", "waiting"):
                continue
            p = dict(p)
            p["state"], p["released"], p["heartbeat"] = "done", now_iso(), now_iso()
            p.pop("question", None)
            sh(["gh", "api", "-X", "PATCH", f"repos/{R}/issues/comments/{c_id}", "-f", f"body={claim_body(p)}"])
            here += 1
        if here:
            sh(["gh", "issue", "edit", str(i["number"]), "-R", R, "--remove-label", LABEL], check=False)
        count += here
    return count


def board_table(body):
    """The body without its refresh stamp, so an unchanged board is detectable."""
    return "\n".join(line for line in body.splitlines() if not line.startswith("_Refreshed "))


def find_board(R):
    """(number, body) of the pinned board issue, duplicates closed; (None, None) if none."""
    found = gh_json("issue", "list", "-R", R, "--state", "open",
                    "--search", "Agent Work Board in:title",
                    "--json", "number", "--limit", "50") or []
    boards = []
    for f in sorted(found, key=lambda i: i["number"]):
        fbody = sh(["gh", "issue", "view", str(f["number"]), "-R", R, "--json", "body", "--jq", ".body"])
        if BOARD_MARK in fbody:
            boards.append((f["number"], fbody))
    for dup, _ in boards[1:]:
        sh(["gh", "issue", "close", str(dup), "-R", R,
            "--comment", "Duplicate Agent Work Board, auto-closed by `wip board`."], check=False)
    return boards[0] if boards else (None, None)


def render_board(R):
    """(body, active claims, claims released on closed issues) for the board as of now."""
    titles = labeled_issues(R)
    released = release_claims_on_closed(R)
    idx = claims_index(R, sorted(titles))
    rows = []
    for n, payloads in sorted(idx.items()):
        for c in active_claims(payloads):
            rows.append((n, titles.get(n, ""), c))
    rows.sort(key=lambda r: (r[2].get("state") != "waiting", r[2]["client"].split(":", 1)[0], r[0]))
    orphans = [n for n, payloads in sorted(idx.items()) if not active_claims(payloads)]
    return board_body(R, rows, orphans), len(rows), released


def sync_board(R):
    """Bring the pinned board in step with the claims after a claim changed.

    Runs at the end of claim, wait and done. The claim comment is already written
    and is what other clients read, so a board that cannot be reached only warns:
    a stale board must never fail a claim that succeeded, the way an unreachable
    API must never block the work. Only `wip board` fails loudly, and only it
    creates the board issue.
    """
    try:
        b, current = find_board(R)
        if b is None:
            return
        body, _, _ = render_board(R)
        if board_table(body) == board_table(current or ""):
            return
        if try_sh(["gh", "issue", "edit", str(b), "-R", R, "--body-file", "-"], input=body):
            print(f"   board #{b} refreshed")
        else:
            sys.stderr.write(f"wip: warning: board #{b} kept its old body; run `wip board`\n")
    except (SystemExit, ValueError):
        sys.stderr.write("wip: warning: the board was not refreshed; run `wip board`\n")


def cmd_board(_arg):
    R = repo()
    body, claims, released = render_board(R)
    b, current = find_board(R)
    if b is None:
        out = sh(["gh", "issue", "create", "-R", R, "--title", "🤖 " + BOARD_TITLE,
                  "--body-file", "-"], input=body)
        print(f"created board issue with {claims} active claim(s) -> {out.splitlines()[-1].strip()}")
        return
    changed = board_table(body) != board_table(current or "")
    if changed and not try_sh(["gh", "issue", "edit", str(b), "-R", R, "--body-file", "-"], input=body):
        die(f"could not write board #{b}")
    print(("refreshed" if changed else "confirmed") + f" board #{b} with {claims} active claim(s)"
          + (f", released {released} claim(s) on closed issues" if released else "")
          + f" -> {issue_url(R, b)}")


def usage():
    print(__doc__.strip())


def pop_issue(tokens):
    """Split an explicit `--issue N` out of a token list -> (issue, rest)."""
    if "--issue" not in tokens:
        return None, tokens
    i = tokens.index("--issue")
    if i + 1 >= len(tokens):
        die("--issue needs an issue number")
    return tokens[i + 1], tokens[:i] + tokens[i + 2:]


def main():
    args = [a for a in sys.argv[1:] if a != "--"]
    force = "--force" in args
    args = [a for a in args if a != "--force"]
    cmd = args[0] if args else "ls"
    arg = args[1] if len(args) > 1 else None
    if cmd in ("-h", "--help", "help"):
        usage()
    elif cmd == "claim":
        cmd_claim(arg, force)
    elif cmd == "done":
        cmd_done(arg)
    elif cmd == "ls":
        cmd_ls(arg)
    elif cmd == "board":
        cmd_board(arg)
    elif cmd == "ask":
        issue, rest = pop_issue(args[1:])
        cmd_ask(" ".join(rest), issue, force)
    elif cmd == "answers":
        issue, _ = pop_issue(args[1:])
        cmd_answers(issue)
    elif cmd == "wait":
        cmd_wait(" ".join(args[1:]), force)
    else:
        die(f"unknown command '{cmd}' (see: wip help)")


if __name__ == "__main__":
    main()
