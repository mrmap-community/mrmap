{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrmap-community.github.io/mrmap/schema/docs-gate-v1.json",
  "title": "MrMap documentation gate artifacts (#1607, epic #1589)",
  "description": "The three machine-readable artifacts the documentation gate reads and writes, validated by the gate itself with scripts/docs_gate.py before anything is trusted or written. One file for all three because they share the identity vocabulary: a report is only meaningful against the same version and commit an evidence record and a coverage floor name. Extra keywords are refused by the gate rather than ignored - see SUPPORTED_KEYWORDS in scripts/docs_gate.py.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "blob": {
      "description": "A git blob id: `git hash-object <path>` answers the same value, which is what makes an evidence record checkable without this gate.",
      "type": "string",
      "pattern": "^sha1:[0-9a-f]{40}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "claim",
        "kind",
        "page",
        "sources",
        "produced_by"
      ],
      "properties": {
        "schema": {
          "const": "mrmap.docs.evidence.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "extracted",
            "executed",
            "inferred",
            "human"
          ]
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "enum": [
            "en",
            "de"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "blob"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "span": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "blob": {
                "$ref": "#/$defs/blob"
              }
            }
          }
        },
        "assertion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "exit_code"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "exit_code": {
              "type": "integer"
            },
            "stdout_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "at": {
              "$ref": "#/$defs/commit"
            }
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "produced_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine"
          ],
          "properties": {
            "engine": {
              "enum": [
                "extractor",
                "generator",
                "browser",
                "author",
                "human"
              ]
            },
            "generator": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "reviewed": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "pull_request": {
              "type": "integer",
              "minimum": 1
            },
            "legacy": {
              "type": "boolean"
            }
          }
        },
        "cited_fact_ids": {
          "description": "The fact ids the prose of an `inferred` record actually rests on. Every entry must exist in facts[] or the record is refused - the mechanical form of 'no invented features'.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "executed"
              }
            }
          },
          "then": {
            "required": [
              "assertion"
            ]
          }
        }
      ]
    },
    "coverage_baseline": {
      "description": "The committed coverage contract: one measurement per discovered surface, with the topics that are not documented today named as gaps. `floor` only ever moves upward; `policy: floor` reports growth as unsupported instead of refusing it (ADR-0001 V-8).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "surfaces"
      ],
      "properties": {
        "schema": {
          "const": "mrmap.docs.coverage-baseline.v1"
        },
        "note": {
          "type": "string"
        },
        "surfaces": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "floor",
              "gaps",
              "policy"
            ],
            "properties": {
              "floor": {
                "type": "integer",
                "minimum": 0
              },
              "gaps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "policy": {
                "enum": [
                  "floor",
                  "floor+growth"
                ]
              },
              "raised_by": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "deterministic",
        "status",
        "attempts",
        "max_attempts"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "deterministic": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "skipped",
            "unsupported",
            "cannot-run"
          ]
        },
        "attempts": {
          "description": "How often the stage actually ran; 0 when it was skipped, never more than max_attempts.",
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "description": "The retry budget of the stage's kind: 1 deterministic, 2 browser-shaped, 3 model-shaped (ADR-0001 section 8).",
          "type": "integer",
          "minimum": 1
        },
        "retry_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt_log": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt",
              "reason"
            ],
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string"
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "detail"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "where": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "note": {
          "description": "Why a stage was skipped or what it did not need; a skipped stage is an answer, not a silence.",
          "type": "string"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "target",
        "candidate",
        "stages",
        "ok",
        "publication"
      ],
      "properties": {
        "schema": {
          "const": "mrmap.docs.gate.v1"
        },
        "target": {
          "enum": [
            "release",
            "pr"
          ]
        },
        "generated_at": {
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "covered",
              "discovered",
              "floor"
            ],
            "properties": {
              "surface": {
                "type": "string"
              },
              "covered": {
                "type": "integer",
                "minimum": 0
              },
              "discovered": {
                "type": "integer",
                "minimum": 0
              },
              "floor": {
                "type": "integer",
                "minimum": 0
              },
              "locale": {
                "enum": [
                  "en",
                  "de"
                ]
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "unsupported"
                ]
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "new_gaps": {
                "description": "Topics not in the corpus and not declared as gaps: a new resource, setting or task that arrived undocumented.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "closed_gaps": {
                "description": "Declared gaps that are documented now: the signal to raise the floor in the same pull request.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing_count": {
                "description": "How many discovered topics no page names, declared gaps included; the lists beside it are bounded so one report stays readable.",
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "locales": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "object"
            },
            "de": {
              "type": "object"
            }
          }
        },
        "ok": {
          "type": "boolean"
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "enum": [
                "allow",
                "retain-previous",
                "block"
              ]
            },
            "keep": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "documented_commit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_digest": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "candidate": {
      "description": "The identity a documentation artifact must be attributable to: the canonical version of the candidate, the exact revision it documents, and the digest of the sources it was built from (ADR-0001 section 6).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "documented_commit",
        "source_digest"
      ],
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "documented_commit": {
          "description": "The revision the artifact documents. Null is allowed here because an ordinary pull request is not attributable to a published revision; the identity stage of the release target is what refuses it.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
