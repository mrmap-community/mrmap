      "default": "20 (4 with MRMAP_LOW_MEMORY)",
      "owner": "docker/backend/.mrmap.env",
      "reader": "backend/MrMap/settings.py",
      "docs": "db-pool-memory"
    },
    {
      "name": "MRMAP_TEST_WORKERS",
      "default": "1 with the #1619 preset; otherwise Django 4 / Vitest automatic",
      "owner": "docker-compose.test-low-memory.yml",
