{
  "schema": "mrmap.task-perf.v1",
  "kind": "baseline",
  "issue": "https://github.com/mrmap-community/mrmap/issues/1396",
  "epic": "https://github.com/mrmap-community/mrmap/issues/1387",
  "stability": {
    "max_cv": 0.03,
    "min_samples": 20,
    "default_repeats": 7,
    "p95_ratio": 1.25,
    "note": "The repeatability floor a verdict needs: the coefficient of variation of an arm's repeat medians must sit inside max_cv before any number of that arm may gate. These are the values the runbook measured as a starting point, not a reviewed judgement about any one family - a family whose own floor is looser says so with max_cv on its entry, because a family that cannot repeat to 3 % cannot be gated at 3 %."
  },
  "review_policy": {
    "who_may_approve": "the performance maintainer named in docs/source/development/celery-task-runtime-benchmarks.rst, or a release manager",
    "what_reviewed_means": "an entry with reviewed=true has had its metrics and ratio looked at against a real run on a documented runner by the person named in approved_by. Until then a benchmark reports and never blocks, which is epic #1387's standing decision: no mandatory performance gate exists until a human approves one.",
    "how_to_approve": "run the workload on a runner like scripts/task_perf_runner.sh's ci profile, read `report` and `compare`, then set reviewed=true, approved_by, reviewed_at and, only if a red check is wanted, block=true on that entry - in a pull request that shows the run it is based on.",
    "shipped_state": "no entry below is reviewed. The file names what the runbook measures and what a reviewer must fill in; it deliberately approves nothing."
  },
