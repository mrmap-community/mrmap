#!/usr/bin/env python3
"""Decision requests: the human-agent decision protocol for mrmap issues.

The repository rule is that only a person decides: only a person applies
`agent: approved`, only a person reviews and merges a pull request, and a
thread a human raised stays open until that human resolves it. This tool
makes those acts auditable instead of buried in comment prose.

An agent posts a request comment listing the open questions, each with
lettered options and the agent's stated recommendation. A human answers with
the question id and the option letter ("Q7: C"), optionally followed by " - "
and a reason. `decisions record` reads the answers, verifies that every one
came from an actor GitHub reports as belonging to the repository, appends one
audit-trail comment per decided question, and `decisions register` syncs the
"Decision register" table in the issue body from that audit trail.

The audit trail is the truth; the register table is a generated view of it,
exactly like the claim comments are the truth and the WIP board is a view of
those. Answering a design question is never implementation approval: the
`agent: approved` label and the human pull-request review stay with people.

Usage:
  scripts/decisions request --issue N --spec FILE [--write]
  scripts/decisions scan --issue N
  scripts/decisions record --issue N [--gate 'Q1-Q6=@user:reason']
                           [--approvers a,b] [--no-reactions] [--write]
  scripts/decisions register --issue N [--map Q4=D10] [--write]
  scripts/decisions reopen --issue N --question Q7 --source URL [--write]
  scripts/decisions override --issue N --question Q7 --outcome Rejected
                           --source URL --reason TEXT [--write]

Answer grammar (one answer per line, or several per line separated by `;`):
  Q7: C
  Q7: C - <free text reason>
  Q7: defer            keywords: approve(d)/yes/agree, reject/no/veto, defer,
                       discuss, unclear; free prose is kept verbatim

The schema, the three gates a change passes (design decisions, the
`agent: approved` implementation label, human PR review) and the resume flow
for OpenCode and Codex are documented in
docs/source/development/decision-requests.rst.

Offline checks for this file live beside it: python3 scripts/test_decisions.py
"""

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import random
import re
import string
import subprocess
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_spec = importlib.util.spec_from_loader(
    "mrmap_wip", importlib.machinery.SourceFileLoader("mrmap_wip", os.path.join(_HERE, "wip")))
wip = importlib.util.module_from_spec(_spec)
sys.modules.setdefault("mrmap_wip", wip)
_spec.loader.exec_module(wip)

REQUEST_RE = re.compile(r"<!--\s*decision-request\s+(\{.*?\})\s*-->", re.DOTALL)
AUDIT_RE = re.compile(r"<!--\s*decision-audit\s+(\{.*?\})\s*-->", re.DOTALL)
NOTE_RE = re.compile(r"<!--\s*decision-note\s*-->")
DEC_MARKS = (REQUEST_RE, AUDIT_RE)
REQ_HEAD_RE = re.compile(r"^\s*#{2,4}\s*(Q\d+)\s*[—:\.\-]+\s*(.*)$")
OPT_LINE_RE = re.compile(r"^\s*[-*]\s*\*{0,2}([A-Z])\*{0,2}\s*(?:\(recommended\)\s*)?[:\)]\s*(.+)")
OPT_AB_RE = re.compile(r"^\s*([A-Z])[\.\)]\s+(.+)")
REC_RE = re.compile(r"\bAgent recommendation:\s*\*{0,2}([A-Z])\b")
SEG_RE = re.compile(r"(?<![A-Za-z0-9_])((Q\d+)(?:\s*(?:/|,|\band\b)\s*Q\d+)*)"
                    r"\s*(?::|=|\u2014| - )\s*")
DEC_HEAD_RE = re.compile(r"^\s*#{2,6}\s*[^\n]*Decision register", re.MULTILINE)
TABLE_HEAD_RE = re.compile(r"^\s*\|[^\n|]*\|[^\n]*\n\s*\|[\s:|\-]+\|\s*$", re.MULTILINE)
QID_RE = re.compile(r"^Q\d+$")
DID_RE = re.compile(r"^D\d+$")

# GitHub reports author_association per comment; only these may decide.
AUTHORIZED = {"OWNER", "MEMBER", "COLLABORATOR"}
STATES = ("Accepted", "Rejected", "Deferred", "Discussed", "Needs clarification")
VOCAB = (
    (("defer", "deferred", "postpone", "postponed", "on hold"), "Deferred"),
    (("discuss", "discussion", "talk", "meeting"), "Discussed"),
    (("approve", "approved", "yes", "agree", "agreed", "ok", "lgtm", "+1",
      "ship it", "ship"), "Accepted"),
    (("reject", "rejected", "veto", "never", "-1"), "Rejected"),
    (("unclear", "clarify", "clarification", "unsure", "idk"), "Needs clarification"),
)
MAX_ASKS = int(os.environ.get("DECISION_MAX_ASKS", "7"))

REGISTER_NOTE = ("> Generated by `scripts/decisions` from the audit trail comments on "
                 "this issue. The audit trail is the truth and this table is a view "
                 "of it; answering the questions is not permission to implement.")


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def sh(cmd, input=None, check=True):
    proc = subprocess.run(cmd, input=input, capture_output=True, text=True)
    if check and proc.returncode != 0:
        die("command failed: %s\n%s" % (" ".join(cmd), proc.stderr.strip() or proc.stdout))
    return proc.stdout


def gh_items(R, path):
    out = sh(["gh", "api", "%s/%s" % ("repos", R) if not path.startswith("repos") else path,
              "--paginate"])
    items, dec, pos = [], json.JSONDecoder(), 0
    while pos < len(out):
        while pos < len(out) and out[pos] in " \n\r\t":
            pos += 1
        if pos >= len(out):
            break
        obj, pos = dec.raw_decode(out, pos)
        items.extend(obj if isinstance(obj, list) else [obj])
    return items


def repo():
    v = json.loads(sh(["gh", "repo", "view", "--json", "owner,name"]))
    return "%s/%s" % (v["owner"]["login"], v["name"])


def git_root():
    return sh(["git", "rev-parse", "--show-toplevel"]).strip()


def cur_branch():
    return sh(["git", "branch", "--show-current"], check=False).strip()


def client_id(root):
    user = sh(["git", "config", "user.name"], check=False).strip()
    if not user:
        user = sh(["gh", "api", "user", "--jq", ".login"], check=False).strip()
    return "%s@%s" % (user or os.environ.get("USER", "unknown"), os.path.basename(root))


try:
    CLIENT = client_id(git_root())
except Exception:  # a frozen identity beats a crashing import
    CLIENT = "unknown"


def infer_issue(explicit):
    """The issue to act on. A branch that only echoes a prompt names nothing.

    The number is read with scripts/wip's own `branch_issue`, the same function
    the board claims go through: only a convention-shaped segment (`issue-<N>`
    at the start of a path segment) carries an issue. AO names worktree branches
    from the spawn prompt text, so a slug like `ao/implement-github-issue-6/root`
    echoes a prompt and declares nothing - #1196 claimed closed issues #5-#7 that
    way, and a decision request posted on a wrong issue asks a human to decide
    something for work that is not theirs. Reusing the function rather than
    copying the pattern is deliberate: two rules that can drift are two rules
    that will.

    What deliberately differs from `wip claim` is the conflict policy. There, an
    explicit number that disagrees with a convention-shaped branch is refused,
    because the branch *is* the claim. Here it is not: recording and reconciling
    decisions for other issues from a housekeeping branch that names its own
    issue is a normal maintenance act. So a mismatch is named on stderr and the
    explicit number - the caller's stated intent - is used.
    """
    branch = cur_branch()
    parsed = wip.branch_issue(branch)
    if explicit:
        if not re.fullmatch(r"#?\d+", str(explicit)):
            die("'%s' is not an issue number" % explicit)
        n = int(str(explicit).lstrip("#"))
        if parsed is not None and parsed != n:
            sys.stderr.write(
                "note: branch %s names issue %d, acting on the given %d; "
                "pass --issue %d if this work belongs to that branch\n"
                % (branch, parsed, n, parsed))
        return n
    if parsed is not None:
        return parsed
    die("cannot infer the issue from the branch; pass --issue")


def fetch_comments(R, n):
    return gh_items(R, "repos/%s/issues/%s/comments" % (R, n))


def fetch_comment(R, cid):
    return sh(["gh", "api", "repos/%s/issues/comments/%s" % (R, cid)], check=False)


def issue_view(R, n):
    v = json.loads(sh(["gh", "issue", "view", str(n), "--json", "body,updatedAt"]))
    return v["body"] or "", v["updatedAt"]


def write_issue_body(R, n, body):
    sh(["gh", "api", "--method", "PATCH", "repos/%s/issues/%s" % (R, n), "-f", "body=" + body])


def post_comment(R, n, body):
    return sh(["gh", "api", "repos/%s/issues/%s/comments" % (R, n), "-f", "body=" + body,
               "--jq", ".html_url"]).strip()


def patch_comment(R, cid, body):
    sh(["gh", "api", "--method", "PATCH", "repos/%s/issues/comments/%s" % (R, cid),
        "-f", "body=" + body])


def reactions_for(R, cid):
    """Raw reaction items; interpretation belongs to reconcile."""
    return gh_items(R, "repos/%s/issues/comments/%s/reactions" % (R, cid),)


def body_hash(text):
    return hashlib.sha256(text.encode()).hexdigest()[:10]


def event_key(qid, src_ref, state, option):
    return "%s|%s|%s|%s" % (qid, src_ref, state, option or "-")


def now_iso():
    return wip.now_iso()


# ------------------------------------------------------------- scanning --

def scan_lines(body):
    """Answer-scanning text: per line, code and quotes blanked in place.

    Fenced and indented blocks, '>' quotes and markdown emphasis become
    spaces so line and offset structure survive: a copy/paste answer template
    inside a request, or a quoted reply, stays data and never answers.
    """
    out, fence = [], None
    for ln in body.split("\n"):
        stripped = ln.strip()
        m = re.match(r"^(`{3,}|~{3,})", stripped)
        if m:
            if fence and stripped.startswith(fence):
                fence = None
            elif not fence:
                fence = m.group(1)[:3]
            out.append(" " * len(ln))
            continue
        if fence or ln.startswith("    ") or ln.startswith("\t") \
                or ln.lstrip().startswith(">"):
            out.append(" " * len(ln))
            continue
        out.append(ln.replace("**", "  ").replace("__", "  "))
    return out


def line_runs(line):
    """Answer runs of one scan line: [{ids, start, payload, end}].

    Grouped ids ("Q7/Q8: A") share one run.
    """
    runs = []
    for m in SEG_RE.finditer(line):
        runs.append({"ids": re.findall(r"Q\d+", m.group(1)), "start": m.start(),
                     "payload": m.end()})
    for i, run in enumerate(runs):
        run["end"] = runs[i + 1]["start"] if i + 1 < len(runs) else len(line)
    return runs


def has_upper_word(text, letter):
    """A human naming option B writes it uppercase; the article "a" is not option A."""
    return re.search(r"(?<![A-Za-z0-9])%s(?![A-Za-z0-9])" % re.escape(letter), text)


def has_word(low, word):
    if word[0].isalnum():
        return re.search(r"\b%s\b" % re.escape(word), low)
    return word in low


def parse_segment(text, ask):
    """(outcome, refused_reason) for one answer run against one ask."""
    rest = re.sub(r"\s+", " ", text.strip().rstrip(";").strip())
    if not rest:
        return None, "answered without an option"
    m = re.match(r"^([A-Z])\b[\.,:;\- )]*\s*(.*)$", rest)
    if m and m.group(1) in ask["options"]:
        letter, tail = m.group(1), m.group(2).strip(" -–—:")
        other = [o for o in ask["options"] if o != letter and has_upper_word(tail, o)]
        if other:
            return None, ("names option %s and option %s; not unambiguous"
                          % (letter, ", ".join(other)))
        return ({"state": "Accepted", "option": letter, "text": ask["options"][letter],
                 "verbatim": tail or None, "note": tail or None}), None
    if re.match(r"^[A-Z]\b", rest):
        return None, "answers with a letter that is not on offer"
    low = rest.lower()
    for words, state in VOCAB:
        if any(has_word(low, w) for w in words):
            note = None
            dm = re.search(r"[-–—]{1,2}\s*(.+)", rest)
            if dm:
                note = dm.group(1).strip()
            return ({"state": state, "option": None, "text": rest,
                     "verbatim": rest, "note": note}), None
    named = sorted(set([o for o in ask["options"] if has_upper_word(rest, o)]
                       + [o for o in ask["options"]
                          if re.search(r"\b%s\b" % re.escape(
                              ask["options"][o].split("(")[0].strip()), rest, re.IGNORECASE)]))
    if len(named) > 1:
        return None, "names options %s; not unambiguous" % ", ".join(named)
    return ({"state": "Accepted", "option": named[0] if named else None,
             "text": rest, "verbatim": rest, "note": None}), None


def adopt_recommendation(outcome, ask):
    """"yes" means the recommendation; say so in the note."""
    if outcome and outcome["state"] == "Accepted" and outcome["option"] is None \
            and ask.get("recommend") and ask["recommend"] in ask["options"]:
        outcome = dict(outcome)
        outcome["option"] = ask["recommend"]
        outcome["note"] = ((outcome.get("note") or "")
                           + " option per the stated recommendation").strip()
    return outcome


def machine_comment(c):
    """Comments this repository's tools manage never ask themselves and never answer.

    wip's is_machine_comment covers the claim, question and board markers on
    unquoted lines; the decision markers are added here so an agent's request
    comment cannot answer the questions it asks.
    """
    body = c.get("body") or ""
    if wip.is_machine_comment(c):
        return True
    return any(rx and wip.unquoted_match(rx, body) for rx in DEC_MARKS)


def c_user(c):
    return c.get("user", {}).get("login", "?")


def c_type(c):
    return c.get("user", {}).get("type") or "User"


def actor_problem(c, approvers):
    """Why this comment cannot carry a human decision, or None."""
    if c_type(c) == "Bot":
        return "author %s is a Bot account and is not counted" % c_user(c)
    assoc = c.get("author_association") or "ANY_COLLABORATOR"
    if assoc not in AUTHORIZED:
        return ("author_association of %s is %s and is not counted; only OWNER, "
                "MEMBER or COLLABORATOR decide" % (c_user(c), assoc))
    if approvers and c_user(c) not in approvers:
        return "%s is not on the approver allowlist and is not counted" % c_user(c)
    return None


def parse_request_comment(c):
    """Questions asked by one comment: marked payload or the rendered shape.

    A marked request is exact. An unmarked comment in the same shape (the
    #992 case) is parsed too, but its provenance cannot be verified after
    the fact — agents post through a maintainer's gh — so callers must warn.
    """
    body = c.get("body", "")
    m = REQUEST_RE.search(body) if body.lstrip().startswith("<!--") else None
    if m:
        try:
            payload = json.loads(m.group(1))
        except json.JSONDecodeError:
            return None, ["request comment %s carries a broken marker; ignored" % c.get("id")]
        return {"marked": True, "payload": payload, "comment": c, "rx": bool(payload.get("rx")),
                "asks": {a["q"]: dict(a) for a in payload.get("asks", []) if QID_RE.match(a.get("q", ""))}}, []

    lines = scan_lines(body)
    asks, cur = {}, None
    for ln in lines:
        hm = REQ_HEAD_RE.match(ln)
        if hm and hm.group(2).strip():
            title = hm.group(2)
            cur = {"q": hm.group(1), "d": re.findall(r"\bD\d+\b", title),
                   "title": re.sub(r"\s*\[BLOCKING\].*$", "", title).split(" →")[0]
                           .split(" D0")[0].split(" D1")[0].split(" D2")[0].strip(" —"),
                   "blocking": "BLOCKING" in title, "options": {}, "recommend": None}
            asks[cur["q"]] = cur
            continue
        if not cur:
            continue
        om = OPT_LINE_RE.match(ln) or OPT_AB_RE.match(ln)
        if om:
            cur["options"][om.group(1)] = om.group(2).replace("(recommended)", "").strip("* ")
            continue
        bm = re.search(r"\[([A-Z]:[^\]]+\|[^\]]+)\]", ln)
        if bm and not cur["options"]:
            for part in re.split(r"\s*\|\s*(?=[A-Z]:)", bm.group(1)):
                km = re.match(r"([A-Z]):\s*(.+)", part.strip())
                if km:
                    cur["options"][km.group(1)] = km.group(2).strip()
            continue
        rm = REC_RE.search(ln)
        if rm and len(cur["options"]) >= 2:
            cur["recommend"] = rm.group(1)
    asks = {q: a for q, a in asks.items() if len(a["options"]) >= 2}
    if not asks:
        return None, []
    return {"marked": False, "payload": None, "comment": c, "rx": False, "asks": asks}, \
        ["comment %s asks questions without a machine marker; its provenance "
         "cannot be verified (posted by %s)" % (c.get("id"), c_user(c))]


def load_requests(comments):
    requests, warnings, first = [], [], {}
    for c in sorted(comments, key=lambda x: x.get("created_at", "")):
        marked = REQUEST_RE.search(c.get("body", "")) if machine_comment(c) else None
        if machine_comment(c) and not marked:
            continue
        parsed, warns = parse_request_comment(c)
        warnings.extend(warns)
        if parsed and parsed["asks"]:
            requests.append(parsed)
            for q in parsed["asks"]:
                first.setdefault(q, parsed)
    return requests, first, warnings


def expand_range(part, spec):
    ids = []
    for p in str(part).split(","):
        if "-" in p and re.match(r"^[QD]\d+", p):
            pfx, lo, hi = p[0], *p.split("-")
            try:
                lo, hi = int(lo[1:]), int(hi[1:])
            except ValueError:
                die("bad range in %r" % spec)
            ids += ["%s%d" % (pfx, k) for k in range(min(lo, hi), max(lo, hi) + 1)]
        else:
            ids.append(p)
    return ids


def parse_gate_specs(gates):
    out = {}
    for spec in gates or []:
        m = re.match(r"^([A-Za-z0-9,\-]+)=(@?[^:]+):(.+)$", str(spec).strip())
        if not m:
            die("bad --gate %r; expected 'Q1-Q6=@user:reason'" % spec)
        for q in expand_range(m.group(1), spec):
            out[q] = {"user": m.group(2).lstrip("@"), "reason": m.group(3).strip()}
    return out


def parse_map_specs(maps):
    out = {}
    for spec in maps or []:
        m = re.match(r"^([A-Za-z0-9,\-]+)=([A-Za-z0-9,\-]+)$", str(spec).strip())
        if not m:
            die("bad --map %r; expected 'Q4=D10'" % spec)
        targets = []
        for d in m.group(2).split(","):
            if not DID_RE.match(d):
                die("bad decision id %r in --map %r" % (d, spec))
            targets.append(d)
        for q in expand_range(m.group(1), spec):
            out.setdefault(q, [])
            out[q] += [d for d in targets if d not in out[q]]
    return out


# ------------------------------------------------------------ reconcile --

def outcome_of(x):
    """Compare key (state, option) of an event or a parsed outcome."""
    if x is None:
        return None
    if isinstance(x, dict):
        state = x.get("state")
        return (state, x.get("option") if state == "Accepted" else None)
    return None


def parse_answer_comment(c, asks):
    """qid -> {outcome | refused} for one comment; {} when it answers none.

    ';' separates two answers on one line; two answers glued together by
    prose are refused as ambiguous, never guessed apart. The same question
    twice in one comment is refused the same way.
    """
    found, ambiguous = {}, set()
    for ln in scan_lines(c.get("body", "")):
        pos, chunks = 0, []
        for piece in ln.split(";"):
            chunks.append((piece, pos))
            pos += len(piece) + 1
        for chunk, offset in chunks:
            runs = line_runs(chunk)
            if len(runs) > 1:
                for run in runs:
                    ambiguous.update(run["ids"])
                continue
            if not runs:
                continue
            run = runs[0]
            text = chunk[run["payload"]:run["end"]]
            for q in run["ids"]:
                if q not in asks:
                    found.setdefault(q, {"foreign": True})
                    continue
                if q in found:
                    ambiguous.add(q)
                    continue
                outcome, reason = parse_segment(text, asks[q])
                found[q] = ({"outcome": adopt_recommendation(outcome, asks[q])}
                            if outcome else {"refused": reason})
    for q in ambiguous:
        found[q] = {"refused": "answered twice in one comment; not unambiguous"}
    return {q: v for q, v in found.items() if v.get("refused") or v.get("outcome")
            or v.get("foreign")}


def build_event(q, outcome, src, ask):
    option = outcome.get("option") if outcome.get("state") == "Accepted" else None
    return {"kind": "answer", "src_kind": "comment", "q": q,
            "d": list(ask.get("d", [])), "state": outcome["state"], "ts": src["created_at"],
            "option": option, "text": outcome.get("text"), "note": outcome.get("note"),
            "verbatim": outcome.get("verbatim"),
            "actor": c_user(src), "assoc": src.get("author_association"),
            "src": src.get("html_url", ""), "src_ts": src["created_at"],
            "src_ref": "c%s:%s" % (src.get("id"), body_hash(src.get("body", "")))}


def reconcile(R, n, gates=(), approvers=None, rx=True, maps=(), comments=None):
    """The whole protocol in one pass: asks, answers, reactions, events.

    Returns {ask_states, decisions, events, new_events, refused, warnings,
    unstructured}. ask_states[q]["state"] is one of Pending, Accepted,
    Rejected, Deferred, Discussed, Needs clarification, Awaiting review.
    new_events are those not yet in the audit trail.
    """
    gates = parse_gate_specs(gates)
    maps = parse_map_specs(maps)
    approvers = set(approvers) if approvers else None
    if comments is None:
        comments = fetch_comments(R, n)
    comments = sorted(comments, key=lambda c: c.get("created_at", ""))
    requests, first, warnings = load_requests(comments)
    asks = {q: p["asks"][q] for q, p in first.items()}
    for q, ds in maps.items():
        if q in asks:
            asks[q]["d"] = list(asks[q].get("d", [])) + [d for d in ds
                                                         if d not in asks[q].get("d", [])]
    refused = []
    for q in gates:
        if q not in asks:
            warnings.append("--gate names %s, which no request asks; ignored" % q)

    state = {q: {"state": "Pending", "ask": ask,
                 "asked_at": first[q]["comment"]["created_at"],
                 "gate": gates.get(q)} for q, ask in sorted(asks.items())}
    comments_by_id = {str(c.get("id")): c for c in comments}
    request_comments = {id(p["comment"]) for p in requests}

    # recorded events are truth; edited sources clarify instead of rewriting
    events = {}
    for c in comments:
        body = c.get("body", "")
        own = AUDIT_RE.search(body) if body.lstrip().startswith("<!--") else None
        if not own:
            continue
        try:
            payload = json.loads(own.group(1))
        except json.JSONDecodeError:
            continue
        for ev in payload.get("events", []):
            events.setdefault(ev.get("key") or "e%d" % len(events), ev)

    for key, ev in sorted(events.items(), key=lambda kv: kv[1].get("ts", "")):
        q = ev.get("q")
        if q not in state:
            continue
        for did in ev.get("d", []):
            if did not in asks[q].setdefault("d", []):
                asks[q]["d"].append(did)  # the link was recorded, not re-typed
        kind = ev.get("kind", "answer")
        if kind in ("reopen", "override"):
            state[q]["state"] = ev.get("state", "Pending")
            state[q]["recorded"] = ev
            continue
        if ev.get("gate") and not state[q]["gate"]:
            state[q]["gate"] = ev["gate"]  # the gate is recorded, not re-typed
        src = comments_by_id.get(str(ev.get("src_ref", "")).split(":")[0].lstrip("c"))
        if src is not None and not machine_comment(src) and id(src) not in request_comments:
            now = parse_answer_comment(src, asks).get(q, {}).get("outcome")
            if now is not None and outcome_of(now) != outcome_of(ev):
                state[q]["state"] = "Needs clarification"
                state[q]["why"] = ("the answer comment was edited after it was recorded; "
                                   "the trail keeps %s, a human must re-answer"
                                   % ev.get("state"))
                continue
        state[q]["state"] = ev.get("state", "Pending")
        state[q]["recorded"] = ev

    # human comment answers, chronologically; only the newest word decides
    candidates = {q: [] for q in state}
    for c in comments:
        if machine_comment(c) or id(c) in request_comments:
            continue
        answers = parse_answer_comment(c, asks)
        for q, got in sorted(answers.items()):
            if q not in state:
                refused.append("comment %s answers %s, which has no open request"
                               % (c.get("id"), q))
                continue
            if got.get("refused"):
                if state[q]["state"] != "Needs clarification":
                    state[q]["state"] = "Needs clarification"
                    state[q]["why"] = got["refused"]
                refused.append("%s: %s" % (q, got["refused"]))
                continue
            if c.get("created_at", "") <= state[q]["asked_at"]:
                refused.append("comment %s is before the request that asks %s; "
                               "not an answer to it" % (c.get("id"), q))
                continue
            problem = actor_problem(c, approvers)
            if problem:
                refused.append("%s: %s" % (q, problem))
                continue
            candidates[q].append({"comment": c, "outcome": got["outcome"]})

    for q, st in state.items():
        if st["state"] == "Needs clarification" or not candidates[q]:
            continue
        rec = st.get("recorded")
        picks = candidates[q]
        if rec and rec.get("kind") in ("reopen", "override"):
            picks = [p for p in picks if p["comment"]["created_at"] > rec.get("ts", "")]
            if not picks:
                continue  # the reopen/override is still the newest word
        groups = {}
        for cand in picks:
            groups.setdefault(outcome_of(cand["outcome"]), []).append(cand)
        if len(groups) > 1:
            st["state"] = "Needs clarification"
            st["why"] = "answered differently by %s; a human must settle it" % \
                ", ".join(sorted({c_user(g[0]["comment"]) for g in groups.values()}))
            continue
        outcome_key, group = sorted(groups.items())[-1]
        src = group[-1]["comment"]
        if rec and rec.get("kind") not in ("reopen", "override") \
                and outcome_of(rec) == outcome_key:
            continue  # that exact outcome is already in the trail
        st["new_event"] = build_event(q, group[-1]["outcome"], src, asks[q])
        if st.get("gate"):
            st["new_event"]["gate"] = st["gate"]

    # reactions: decisive only on an explicit opt-in for exactly one question
    if rx:
        for req in requests:
            if not req["rx"]:
                continue
            if len(req["asks"]) != 1:
                warnings.append("request %s opted into reactions but holds %d questions; "
                                "a reaction cannot name one; ignored"
                                % (req["comment"].get("id"), len(req["asks"])))
                continue
            q = list(req["asks"])[0]
            if q not in state:
                continue
            items = reactions_for(R, req["comment"].get("id"))
            plus = {r["user"]["login"] for r in items
                    if r.get("content") == "+1" and r["user"].get("type") != "Bot"}
            minus = {r["user"]["login"] for r in items
                     if r.get("content") == "-1" and r["user"].get("type") != "Bot"}
            if not plus and not minus:
                continue
            if approvers is not None:
                plus = {u for u in plus if u in approvers}
                minus = {u for u in minus if u in approvers}
                if not plus and not minus:
                    continue  # every reactor was off the allowlist
            else:
                refused.append("%s: reactions were read but there is no approver "
                               "allowlist, so they decide nothing" % q)
            info = ", ".join("+1 from %s" % u for u in sorted(plus | minus))
            if plus and minus:
                state[q]["reaction"] = info + "; this conflicts"
                continue
            state[q]["reaction"] = info
            answered = state[q].get("recorded") or state[q].get("new_event") \
                or state[q]["state"] != "Pending"
            if answered or approvers is None:
                continue  # words beat emoji; without an allowlist emoji decide nothing
            ask = asks[q]
            approve = bool(plus)
            option = ask.get("recommend") if approve else None
            if option not in ask["options"]:
                option = None
            src = req["comment"]
            ev = {"kind": "reaction", "src_kind": "reaction", "q": q,
                  "d": list(ask.get("d", [])) + maps.get(q, []),
                  "state": "Accepted" if approve else "Rejected",
                  "ts": src["created_at"], "option": option if approve else None,
                  "text": ask["options"].get(option, "the recommendation") if option
                          else "the recommendation",
                  "note": "reaction consensus; option per the stated recommendation",
                  "actor": ", ".join(sorted(plus | minus)), "assoc": "reaction",
                  "reactor_type": "User", "src": src.get("html_url", ""),
                  "src_ts": src["created_at"],
                  "src_ref": "c%s:rx%s" % (src.get("id"),
                                           body_hash("".join(sorted(plus | minus))))}
            ev["key"] = event_key(q, ev["src_ref"], ev["state"], ev["option"])
            if ev["key"] in events:
                continue
            if state[q].get("gate"):
                ev["gate"] = state[q]["gate"]
            state[q]["new_event"] = ev

    for q, st in state.items():
        if st.get("new_event"):
            st["state"] = st["new_event"]["state"]
            st["accepted"] = st["new_event"]
        if st.get("gate") and st["state"] in STATES:
            st["state"] = "Awaiting review"

    decisions = {}
    for q, st in sorted(state.items()):
        dids = list(asks[q].get("d", []))
        for did in dids:
            cur = decisions.setdefault(did, {"state": "Pending", "via": []})
            s = st["state"]
            if st.get("gate"):
                actor = (st.get("recorded") or st.get("new_event") or {}).get("actor", "")
                s = "Accepted" if actor == st["gate"]["user"] else \
                    "Awaiting @%s" % st["gate"]["user"]
            if cur["state"] == "Pending" or s.startswith("Awaiting"):
                cur["state"] = s if s != "Pending" else cur["state"]
            cur["via"].append(q)

    unstructured = []
    latest_ask = max((st["asked_at"] for st in state.values()), default="")
    for c in comments:
        if machine_comment(c) or id(c) in request_comments:
            continue
        if c.get("created_at", "") <= latest_ask or not c.get("body", "").strip():
            continue
        if not parse_answer_comment(c, asks):
            unstructured.append({"actor": c_user(c), "text": c["body"].strip()[:200]})

    new_events = [st["new_event"] for st in state.values() if st.get("new_event")]
    return {"ask_states": state, "decisions": decisions, "events": events,
            "new_events": new_events, "refused": refused, "warnings": warnings,
            "unstructured": unstructured}


def assert_source(ev):
    """Refuse to record an event that cannot be traced to verifiable evidence."""
    if ev.get("kind") == "recommendation":
        die("an agent recommendation cannot be recorded as a decision; only a "
            "human answer decides")
    if not ev.get("src"):
        die("a decision event must carry the source reference it came from")
    if ev.get("src_kind") == "reaction" and ev.get("reactor_type") == "Bot":
        die("a reaction from a Bot account never decides")
    return True


# -------------------------------------------------------------- request --

def load_spec(path):
    """Read and validate a request spec file: {"asks": [...], "rx": bool}."""
    try:
        with open(path) as handle:
            spec = json.load(handle)
    except (OSError, json.JSONDecodeError) as err:
        die("cannot read spec %s: %s" % (path, err))
    asks = spec.get("asks", [])
    if len(asks) > MAX_ASKS:
        die("a request may hold at most %d questions; this spec has %d. Asking in "
            "one go is the wall-of-questions problem this protocol exists to stop"
            % (MAX_ASKS, len(asks)))
    for a in asks:
        if not QID_RE.match(a.get("q", "")):
            die("ask %r needs an id like Q7" % a.get("q"))
        if len(a.get("options", {})) < 2:
            die("%s needs at least two options" % a["q"])
        if not a.get("recommend"):
            die("%s has no recommendation; an agent must state its own view before "
                "asking a human" % a["q"])
        if a["recommend"] not in a["options"]:
            die("%s recommends %r, which is not one of its options" % (a["q"], a["recommend"]))
    if spec.get("rx") and len(asks) != 1:
        die("reactions may be offered for exactly one question; a thumbs-up on "
            "several cannot say which one it approves")
    return asks, bool(spec.get("rx")), spec


def render_request(payload):
    """The request comment: machine marker first, then the readable questions."""
    asks = payload["asks"]
    lines = ["<!-- decision-request %s -->" % json.dumps(payload, separators=(",", ":")), "",
             "**Decision request — this is a proposal, not approval.** Answering the "
             "questions below is a design decision; it is not the `agent: approved` "
             "label and not a pull request approval.", ""]
    for a in asks:
        title = "%s — %s" % (a["q"], a.get("title", a["q"]))
        if a.get("blocking"):
            title += " [BLOCKING]"
        if a.get("d"):
            title += " → " + ", ".join(a["d"])
        lines.append("### " + title)
        lines.append("")
        for letter in sorted(a["options"]):
            if letter == a.get("recommend"):
                lines.append("- **%s (recommended): %s**" % (letter, a["options"][letter]))
            else:
                lines.append("- %s: %s" % (letter, a["options"][letter]))
        lines.append("")
        lines.append("**Agent recommendation: %s** — %s"
                     % (a["recommend"], a.get("why", "see the option text")))
        if a.get("gate"):
            lines.append("_Even a clear answer is only a preference here; %s owns "
                         "the decision._" % a["gate"])
        lines.append("")
    lines.append("**status: pending** — one answer per line; `;` separates two:")
    lines.append("")
    lines.append("```")
    lines.append("\n".join("%s: %s" % (a["q"], a["recommend"]) for a in asks))
    lines.append("%s: B - the reason, if you want to give one" % asks[-1]["q"])
    lines.append("```")
    lines.append("")
    lines.append("Keywords work too (approve, reject, defer, discuss, unclear); prose "
                 "is kept verbatim. Answers from OWNER, MEMBER or COLLABORATOR accounts "
                 "are recorded as decisions with a verifiable source. Answering is a "
                 "design decision, not a pull request approval.")
    return "\n".join(lines) + "\n"


def audit_body(payload, events, extra_lines):
    """One audit-trail comment: the marker payload plus a human-readable digest."""
    payload = dict(payload)
    payload["events"] = events
    lines = ["<!-- decision-audit %s -->" % json.dumps(payload, separators=(",", ":")), ""]
    for ev in events:
        q = ev.get("q") or ("decision " + str(ev.get("d", "?")))
        text = "`%s` **%s**" % (q, ev.get("state"))
        if ev.get("option"):
            text += " (option %s: %s)" % (ev["option"], ev.get("text") or "")
        elif ev.get("text"):
            text += " (%s)" % ev["text"]
        text += " — %s by %s" % (ev.get("src", "no source"), ev.get("actor", "?"))
        if ev.get("note"):
            text += " — reason: %s" % ev["note"]
        if ev.get("gate"):
            text += " — recorded as a preference; @%s owns the decision (%s)" % (
                ev["gate"]["user"], ev["gate"]["reason"])
        lines.append(text)
    for ln in extra_lines or []:
        lines.append(ln)
    lines.append("")
    lines.append("Recorded by %s. This trail is the truth for the Decision register; "
                 "recording these answers is not implementation approval — only a "
                 "person applies `agent: approved`." % CLIENT)
    return "\n".join(lines) + "\n"


def cmd_request(issue, spec_path, write):
    asks, rx, spec = load_spec(spec_path)
    R = repo()
    n = infer_issue(issue)
    comments = fetch_comments(R, n)
    requests, asked, warnings = load_requests(comments)
    ids = [a["q"] for a in asks]
    payload = {"v": 1, "id": "dr-%s" % body_hash("".join(ids) + now_iso())[:8],
               "client": CLIENT, "issue": n, "asks": asks, "rx": rx,
               "hash": body_hash(json.dumps(asks, sort_keys=True)), "version": 1,
               "status": "pending", "created": now_iso(),
               "register": spec.get("register", ""), "rfc": spec.get("rfc", "")}
    body = render_request(payload)
    same = next((r for r in requests if set(r["asks"]) == set(ids)), None)
    if same:
        print("issue #%d: these questions are already open: %s" % (n, ", ".join(ids)))
        if not write:
            return
        if same["comment"].get("body") != body:
            patch_comment(R, same["comment"]["id"], body)
        print("  refreshed the request comment in place (same question ids)")
        return
    for w in warnings:
        print("  warning: " + w)
    print("issue #%d: asked %s" % (n, ", ".join(ids)))
    if not write:
        print("\nwould post (no GitHub call without --write):")
        print(body)
        return
    print(post_comment(R, n, body))


def cmd_scan(issue, no_reactions):
    R = repo()
    n = infer_issue(issue)
    st = reconcile(R, n, rx=not no_reactions)
    print("issue #%d: %d question(s)" % (n, len(st["ask_states"])))
    for w in st["warnings"]:
        print("  warning: " + w)
    for r in st["refused"]:
        print("  refused: " + r)
    for q, s in sorted(st["ask_states"].items(), key=lambda kv: int(kv[0][1:])):
        extra = " (recorded: %s)" % s["recorded"].get("kind", "answer") if s.get("recorded") else ""
        print("  %s: %s%s" % (q, s["state"], extra))
    for did, d in sorted(st["decisions"].items()):
        print("  %s: %s (via %s)" % (did, d["state"], ", ".join(d["via"])))
    if st["unstructured"]:
        print("  %d unstructured reply comment(s); answers that do not name their "
              "question cannot be read" % len(st["unstructured"]))


# -------------------------------------------------------------- record --

def cmd_record(issue, gates, approvers, write, no_reactions=False, map_specs=()):
    R = repo()
    n = infer_issue(issue)
    if approvers is None:
        env = os.environ.get("MRMAP_DECISION_APPROVERS", "")
        approvers = set(a.strip() for a in env.split(",") if a.strip()) or None
    st = reconcile(R, n, gates, approvers, not no_reactions, map_specs)
    for w in st["warnings"]:
        print("  warning: " + w)
    for r in st["refused"]:
        print("  refused: " + r)
    for q, s in sorted(st["ask_states"].items(), key=lambda kv: int(kv[0][1:])):
        print("  %s: %s" % (q, s["state"]))
    if not st["new_events"]:
        print("nothing to record")
        return
    for ev in st["new_events"]:
        assert_source(ev)
    payload = {"v": 1, "id": "au-%s" % "".join(random.choices(string.hexdigits.lower(), k=8)),
               "client": CLIENT, "issue": n}
    body = audit_body(payload, st["new_events"], [])
    print("%d decision event(s) ready:" % len(st["new_events"]))
    for ev in st["new_events"]:
        print("  %s: %s%s by %s <- %s"
              % (ev["q"], ev["state"], " (option %s)" % ev["option"] if ev.get("option") else "",
                 ev["actor"], ev["src"]))
    if not write:
        print("\nwould append one audit comment (no GitHub call without --write):")
        print(body)
        return
    print(post_comment(R, n, body))


# ------------------------------------------------------------ register --

def cmd_register(issue, gates, approvers, write, reactions=True, map_specs=()):
    R = repo()
    n = infer_issue(issue)
    comments = fetch_comments(R, n)
    st = reconcile(R, n, gates, approvers, reactions, map_specs, comments)
    body, stamp = issue_view(R, n)
    table = find_register_table(body)
    if table is None:
        die("the issue body has no parseable 'Decision register' table; add one "
            "(ID | Topic | Status | Decision / evidence | Reviewer) under a "
            "'Decision register' heading instead of letting this tool guess")
    events = list(st["events"].values()) + st["new_events"]
    by_did = {}
    for ev in events:
        for did in ev.get("d", []):
            by_did.setdefault(did, []).append(ev)
    rows = register_rows(body, table)
    changes = []
    for did, row in rows.items():
        open_refs = [q for q in re.findall(r"\bQ\d+\b", row["evidence"])
                     if q in st["ask_states"] and st["ask_states"][q]["state"] == "Pending"]
        if open_refs:
            print("  %s waits on %s; the row stays open" % (did, ", ".join(open_refs)))
            continue
        evs = sorted(by_did.get(did, []), key=lambda e: e.get("ts", ""))
        if not evs:
            continue
        status, evidence = register_status(evs[-1], (st["decisions"].get(did) or {}).get("state"))
        if status is None:
            continue
        if row["status"] != status or row["evidence"] != evidence:
            changes.append(did)
            print("  %s: %r -> %s" % (did, row["status"], status))
    for did in sorted(by_did):
        if did not in rows:
            print("  warning: events reference %s, which the register does not list; "
                  "add the row by hand" % did)
    stale_note = NOTE_RE.search(body) and REGISTER_NOTE not in body
    if not changes and not stale_note:
        print("nothing changed")
        return
    new_body = apply_register(body, rows, by_did, table)
    if not write:
        print("\nwould write the issue body (no GitHub call without --write)")
        show_diff(body, new_body)
        return
    fresh_body, fresh_stamp = issue_view(R, n)
    if fresh_body != body or fresh_stamp != stamp:
        die("the issue body changed since it was read; rerun so the register reflects "
            "the newest answers")
    write_issue_body(R, n, new_body)
    print("updated the issue body")


def register_status(ev, did_state=None):
    kind = ev.get("kind", "answer")
    ts = (ev.get("ts") or "")[:10]
    if kind == "reopen":
        return "Reopened %s" % ts, "reopened — see audit trail %s" % ev.get("src", "")
    if kind == "override":
        return "%s %s" % (ev.get("state"), ts), "override via %s by %s" % (
            ev.get("src"), ev.get("actor"))
    if ev.get("gate"):
        return ("Awaiting @%s" % ev["gate"]["user"],
                "answer recorded as a preference at %s; %s owns the decision (%s)"
                % (ev.get("src"), ev["gate"]["user"], ev["gate"]["reason"]))
    if did_state and did_state.startswith("Awaiting"):
        return did_state, "answer on record at %s" % ev.get("src", "")
    state = ev.get("state")
    if state in ("Needs clarification", "Pending"):
        return None, None
    if state == "Accepted":
        return ("Accepted %s" % ts,
                "%s (option %s)" % (ev.get("src"), ev["option"]) if ev.get("option")
                else str(ev.get("src")))
    if state in ("Rejected", "Deferred", "Discussed"):
        return "%s %s" % (state, ts), "%s%s" % (
            ev.get("src"), " (%s)" % ev["note"] if ev.get("note") else "")
    return None, None


def find_register_table(body):
    """(header_start, header_end) of the Decision register table, or None."""
    for hm in DEC_HEAD_RE.finditer(body):
        tm = TABLE_HEAD_RE.search(body[hm.end():])
        if tm:
            return (hm.end() + tm.start(), hm.end() + tm.end())
    return None


def row_cells(line):
    cells, buf, esc = [], "", False
    for ch in line:
        if esc:
            buf += ch
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == "|":
            cells.append(buf.strip())
            buf = ""
        else:
            buf += ch
    if cells and cells[0] == "":
        cells.pop(0)
    if cells:
        cells[-1] = cells[-1].strip()
    return cells


def register_rows(body, table):
    rows, pos = {}, table[1]
    if body.startswith("\n", pos):
        pos += 1
    while pos < len(body):
        nl = body.find("\n", pos)
        line = body[pos:nl if nl != -1 else len(body)]
        if not line.strip().startswith("|"):
            break
        cells = row_cells(line)
        if len(cells) >= 4 and DID_RE.match(cells[0]):
            rows[cells[0]] = {"start": pos, "end": nl + 1 if nl != -1 else len(body),
                              "cells": cells, "status": cells[2].strip("* "),
                              "evidence": cells[3]}
        pos = nl + 1 if nl != -1 else len(body)
    return rows


def apply_register(body, rows, by_did, table):
    """Rewrite decided rows plus the managed note; nothing else is touched."""
    lines = body.split("\n")
    for did, row in rows.items():
        evs = sorted(by_did.get(did, []), key=lambda e: e.get("ts", ""))
        if not evs:
            continue
        status, evidence = register_status(evs[-1])
        if status is None:
            continue
        cells = list(row["cells"])
        cells[2] = "**%s**" % status
        cells[3] = evidence.replace("|", "\\|")
        lines[body[:row["start"]].count("\n")] = "| " + " | ".join(cells) + " |"
    new_body = "\n".join(lines)
    if NOTE_RE.search(new_body):
        new_body = re.sub(r"<!--\s*decision-note\s*-->\n(?:> [^\n]*\n)?",
                          "<!-- decision-note -->\n" + REGISTER_NOTE + "\n",
                          new_body, count=1)
    else:
        end = max(r["end"] for r in register_rows(new_body, table).values()) \
            if register_rows(new_body, table) else table[1]
        new_body = (new_body[:end] + "\n<!-- decision-note -->\n" + REGISTER_NOTE + "\n"
                    + new_body[end:])
    return new_body


def show_diff(old, new, limit=40):
    import difflib
    out = list(difflib.unified_diff(old.split("\n"), new.split("\n"),
                                    "current", "register", lineterm="", n=1))
    for ln in out[:limit]:
        print("  " + ln[:160])
    if len(out) > limit:
        print("  ... %d more diff lines" % (len(out) - limit))


# ------------------------------------------------------ reopen/override --

def comment_from_url(R, url):
    m = re.search(r"issuecomment-(\d+)", url)
    if not m:
        die("the source must be a link to an issue comment; got %r" % url)
    raw = fetch_comment(R, m.group(1))
    c = raw if isinstance(raw, dict) else None
    if c is None:
        try:
            c = json.loads(raw)
            if not isinstance(c, dict) or not c.get("id"):
                raise ValueError
        except (TypeError, ValueError):
            die("the source comment %s does not exist on this issue" % m.group(1))
    c.setdefault("html_url", url)
    return c


def scan_text(c):
    return "\n".join(scan_lines(c.get("body", "")))


def verify_human_source(R, url, qid):
    """A reopen or override must trace to a human comment naming its question."""
    c = comment_from_url(R, url)
    if machine_comment(c):
        die("a machine-managed comment cannot be the source of a decision")
    problem = actor_problem(c, None)
    if problem:
        die("%s — this author cannot decide" % problem.split(" and is not")[0])
    if qid and qid not in scan_text(c):
        die("the source comment does not mention %s; cite a comment that speaks "
            "about this question" % qid)
    return c


def cmd_reopen(issue, qid, source, reason, approvers, write):
    R = repo()
    n = infer_issue(issue)
    c = verify_human_source(R, source, qid)
    ev = {"kind": "reopen", "src_kind": "comment", "q": qid, "d": [], "state": "Pending",
          "ts": now_iso(), "option": None, "text": reason or "reopened at human request",
          "note": reason, "actor": c_user(c), "assoc": c.get("author_association"),
          "src": c.get("html_url", source), "src_ts": c.get("created_at", ""),
          "src_ref": "c%s:%s" % (c.get("id"), body_hash(c.get("body", "")))}
    ev["key"] = event_key(qid, ev["src_ref"], "Pending", None)
    assert_source(ev)
    body = audit_body({"v": 1, "id": "au-%s" % body_hash(ev["key"])[:8],
                       "client": CLIENT, "issue": n}, [ev], [])
    print("%s on issue #%d would be reopened by %s:" % (qid, n, ev["actor"]))
    print(body)
    if not write:
        return
    print(post_comment(R, n, body))


def cmd_override(issue, qid, outcome, source, reason, approvers, write):
    R = repo()
    n = infer_issue(issue)
    if outcome not in STATES:
        die("--outcome must be one of: %s" % ", ".join(STATES))
    c = verify_human_source(R, source, qid)
    ev = {"kind": "override", "src_kind": "comment", "q": qid, "d": [], "state": outcome,
          "ts": now_iso(), "option": None, "text": reason, "note": reason,
          "actor": c_user(c), "assoc": c.get("author_association"),
          "src": c.get("html_url", source), "src_ts": c.get("created_at", ""),
          "src_ref": "c%s:%s" % (c.get("id"), body_hash(c.get("body", "")))}
    ev["key"] = event_key(qid, ev["src_ref"], outcome, None)
    assert_source(ev)
    body = audit_body({"v": 1, "id": "au-%s" % body_hash(ev["key"])[:8],
                       "client": CLIENT, "issue": n}, [ev], [])
    print("%s on issue #%d would be overridden to %s by %s:" % (qid, n, outcome, ev["actor"]))
    print(body)
    if not write:
        return
    print(post_comment(R, n, body))


# ------------------------------------------------------------------ cli --

def main():
    ap = argparse.ArgumentParser(prog="scripts/decisions",
                                 description="auditable human decisions for mrmap issues")
    ap.add_argument("--issue", help="issue number; defaults to the branch")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("request", help="post a numbered decision request")
    p.add_argument("--spec", required=True, help="JSON spec of the questions")
    p.add_argument("--write", action="store_true", help="post to GitHub")

    p = sub.add_parser("scan", help="what is asked, answered, open")
    p.add_argument("--no-reactions", action="store_true")

    p = sub.add_parser("record", help="read answers, append audit-trail events")
    p.add_argument("--gate", action="append", default=[], metavar="Q1-Q6=@user:reason")
    p.add_argument("--map", action="append", default=[], metavar="Q4=D10")
    p.add_argument("--approvers", help="comma list; only these logins may answer")
    p.add_argument("--no-reactions", action="store_true")
    p.add_argument("--write", action="store_true", help="post to GitHub")

    p = sub.add_parser("register", help="sync the register table from the trail")
    p.add_argument("--map", action="append", default=[], metavar="Q4=D10")
    p.add_argument("--gate", action="append", default=[], metavar="Q1-Q6=@user:reason")
    p.add_argument("--no-reactions", action="store_true")
    p.add_argument("--write", action="store_true", help="write the issue body")

    p = sub.add_parser("reopen", help="a human sends a question back to open")
    p.add_argument("--question", required=True)
    p.add_argument("--source", required=True, help="comment URL that asks for it")
    p.add_argument("--reason")
    p.add_argument("--write", action="store_true", help="post to GitHub")

    p = sub.add_parser("override", help="a human decides without re-answering")
    p.add_argument("--question", required=True)
    p.add_argument("--outcome", required=True, choices=STATES)
    p.add_argument("--source", required=True, help="comment URL with the decision")
    p.add_argument("--reason", required=True)
    p.add_argument("--write", action="store_true", help="post to GitHub")

    args = ap.parse_args()
    if args.cmd == "request":
        cmd_request(args.issue, args.spec, args.write)
    elif args.cmd == "scan":
        cmd_scan(args.issue, args.no_reactions)
    elif args.cmd == "record":
        cmd_record(args.issue, args.gate,
                   set(a.strip() for a in (args.approvers or "").split(",") if a.strip())
                   or None, args.write, args.no_reactions, args.map)
    elif args.cmd == "register":
        cmd_register(args.issue, args.gate, None, args.write, not args.no_reactions, args.map)
    elif args.cmd == "reopen":
        cmd_reopen(args.issue, args.question, args.source, args.reason, None, args.write)
    elif args.cmd == "override":
        cmd_override(args.issue, args.question, args.outcome, args.source, args.reason,
                     None, args.write)


if __name__ == "__main__":
    main()
