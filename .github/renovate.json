{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "pip_requirements", "dockerfile", "docker-compose", "github-actions"],
  "dependencyDashboard": true,
  "prCreation": "immediate",
  "automerge": false,
  "branchConcurrentLimit": 1,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "pip_requirements": {
    "managerFilePatterns": ["/^backend/\\.requirements/(base|dev|docs)\\.txt$/"]
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "prCreation": "immediate",
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Keep TypeScript compatible with typescript-eslint 8.72.0",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "Keep Django compatible with django-celery-beat 2.9.0",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["Django"],
      "allowedVersions": "<6.1"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend non-major dependencies"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "backend non-major dependencies"
    },
    {
      "description": "Group container image non-major updates into one PR",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "container images non-major dependencies"
    },
    {
      "description": "Group non-major action updates, which mostly means the digest-pinned SonarCloud scan",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions non-major dependencies"
    },
    {
      "description": "Keep the CI Python in actions/setup-python on the 3.12 line that python:3.12.14-alpine3.24 ships",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.13"
    },
    {
      "description": "OpenObserve is pre-1.0, so every minor can break ingestion; keep it out of the group PR",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["openobserve/openobserve"],
      "groupName": "openobserve"
    },
    {
      "description": "The docs image is built by neither compose nor CI, bump it by hand",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["docker/docs/**"],
      "enabled": false
    }
  ]
}
