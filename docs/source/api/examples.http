# @name postOgcService
# A valid registration of a WMS, WFS or CSW is answered with HTTP 202 whose
# body is the `BackgroundProcess` of the registration - see # @name getProcess
# below - and no longer a `TaskResult` (#1177).
POST {{host}}api/v1/registry/csw/ HTTP/1.1
content-type: application/vnd.api+json
Referer: {{host}}api/v1/registry/csw/
X-CSRFToken: {{csrf_token}}

{
  "data": {
    "type": "CatalogueService",
    "attributes": {
      "get_capabilities_url": "https://www.geoportal-bw.de/geonetwork/srv/ger/csw?REQUEST=GetCapabilities&VERSION=2.0.2&SERVICE=CSW"
    },
    "relationships": {
      "owner": {
        "data": {"id": 1, "type": "Organization" }
      }
      
   
    }
  }
}

###

# @name getWmsList
GET {{host}}api/v1/registry/wms/ HTTP/1.1
Content-Type: application/vnd.api+json
Cookie: djdtSQLPanel={{sql_timing}};
Referer: {{host}}api/v1/registry/wms/

###

# @name getProcessList
GET {{host}}api/notify/background-processes/
Content-Type: application/vnd.api+json
Referer: {{host}}api/registry/wms/

###

# @name getProcess
# The 202 answer of a service registration names its polling resource: the
# `BackgroundProcess` in `data`, addressed absolutely by the `Content-Location`
# header. Polling it alone answers the queued, running and terminal states of
# the registration and, as soon as it exists, the service it built in
# `relatedResource`; metadata steps which failed are readable in the `logs`
# of the process (#1177, D01/B and D02/A of #1175).
GET {{host}}api/notify/background-processes/1/
Content-Type: application/vnd.api+json
Referer: {{host}}api/registry/wms/


###

# @name getUserList
GET {{host}}api/v1/users/users/
Content-Type: application/vnd.api+json
Referer: {{host}}api/v1/registry/wms/

###

# @name addUser
POST {{host}}api/v1/users/users/
Content-Type: application/vnd.api+json
X-CSRFToken: {{csrf_token}}
Referer: {{host}}api/v1/registry/wms/

{
  "data": {
    "type": "User",
    "attributes": {
      "is_superuser": false,
      "username": "testuser10",
      "password": "test",
      "is_active": true
    },
    "relationships": {
      "groups": {
        "data": [
          {
            "type": "Group",
            "id": "1"
          
          }
        ]
      }   
    }
  }
}


###

# @name login
POST {{host}}api/v1/accounts/login/ HTTP/1.1
Content-Type: application/vnd.api+json
Referer: {{host}}api/v1/accounts/login/

{
  "data": {
    "type": "Login",
    "attributes": {
      "username": "{{username}}",
      "password": "{{password}}"
    }
  }
}

