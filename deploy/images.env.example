# Deployment image identity (#1582) - copy the values into the deployment's
# .env; scripts/image_version.py --check-deploy enforces every rule below on
# the committed example and --check-deploy --env <file> enforces them on a
# real deployment env.
#
# The ONE version of the mrmap artifact set. Every mrmap service pulls
# exactly this tag; the value is never a moving target:
#
#   MRMAP_IMAGE_TAG=0.2.0            a stable release artifact
#   MRMAP_IMAGE_TAG=0.2.0-rc.1       a prerelease artifact (deployable; the
#                                    channel rule gates PUBLISHING names, not
#                                    what may run)
#   MRMAP_IMAGE_TAG=dev-<40-hex>     a SHA-tagged dev artifact
#
# latest / main / edge / an unpinned half-version are refused: an artifact
# deployment that cannot name its version cannot answer "which build is
# this" - the question #1445's system info and the About display exist for.
MRMAP_IMAGE_TAG=0.1.0

# Optional digest pins (pull-time verification, one per repository - the
# digests of the two artifact images differ). A digest is the promotion
# identity: see docs/source/development/versioned-images.rst for
# `docker buildx imagetools create` and why a name moves by digest and never
# by rebuild.
# MRMAP_BACKEND_IMAGE_DIGEST=sha256<64-hex>
# MRMAP_FRONTEND_IMAGE_DIGEST=sha256<64-hex>

# Third-party images (postgis, redis, haproxy, victoria-logs, grafana,
# pgadmin, flower) are NOT here: they stay pinned in docker-compose.yml,
# independently of the mrmap artifact set - each moves with its own CVE or
# feature decision, and --check-deploy refuses any of them floating.

# Everything that could be a secret stays out of this file and out of
# deploy/ entirely: the base compose interpolates those from the operator's
# .env with ${VAR:?...}. No committed deployment file ever carries one.
