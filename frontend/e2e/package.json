{
  "name": "mrmap-e2e",
  "private": true,
  "description": "Browser acceptance harness for the built SPA behind nginx (issue #1034). Runs in the mcr.microsoft.com/playwright image; not part of the application build.",
  "scripts": {
    "test": "playwright test",
    "bdd:gen": "bddgen",
    "bdd:test": "bddgen && playwright test --project=bdd",
    "bdd:smoke": "bddgen && playwright test --project=bdd --grep-invert @exploratory",
    "bdd:demonstrate": "bddgen && E2E_INTENTIONAL_FAILURE=1 playwright test --project=bdd --grep '@intentional-failure'",
    "bdd:steps": "bddgen export"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "playwright-bdd": "9.2.1"
  }
}
