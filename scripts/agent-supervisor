#!/usr/bin/env python3
"""The operator's command in one word: `agent-supervisor`.

Runs the package next to it, from any working directory, with the host's
python3 - the same standard-library-only rule as scripts/wip and
scripts/agent_capacity. Run `agent-supervisor --help` for the commands.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from agent_supervisor.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
