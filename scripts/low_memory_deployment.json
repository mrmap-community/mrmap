  "health_checks": [
    {
      "service": "postgis",
      "test": ["CMD-SHELL", "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""],
      "interval": "10s"
    },
    {
      "service": "redis",
      "test": ["CMD", "redis-cli", "ping"],
      "interval": "5s"
    },
    {
      "service": "celery-worker",
      "test": ["CMD-SHELL", "python -m system.worker_healthcheck"],
      "interval": "15s"
    },
    {
      "service": "celery-beat",
      "test": ["CMD", "python", "-c", "import pathlib,time; p=pathlib.Path('/var/mrmap/run/beat-heartbeat'); raise SystemExit(0 if p.exists() and 0 <= time.time()-p.stat().st_mtime < 30 else 1)"],
      "interval": "10s"
    }
  ],
