#!/usr/bin/env python3
"""stack_memory_profile - read-only memory sampler for one Compose stack (#1613).

The runtime-memory epic (#1612) needs baselines nobody has to re-measure by
hand, and the #1054 lesson says what to measure: the charge a stack puts on
the cgroup that owns it, split into what can be reclaimed and what cannot.
This tool only READS: cgroup files of the stack's containers and of its own
cgroup, plus `docker ps`/`docker inspect` for the container list. It never
writes a cgroup file, never touches compose state, never scales anything.

What each sample records per container: memory.current, memory.peak where
the kernel carries it, the anon/file/slab split from memory.stat, the OOM
counters of memory.events (as a delta over the sampling window - they are
cumulative), the cpu.stat usage and throttle counters (same delta rule), and
on a coarser cadence the per-process view of /proc/<pid>/status: RSS with its
anon/file/shmem split per command name, which is how PostgreSQL's shared
buffers are told apart from private memory (#1613). Proportional Set Size is
NOT measured: it would need /proc/<pid>/smaps_rollup, which an unprivileged
agent container may not read, and an invented PSS is worse than the gap. And
the same numbers for the SAMPLER's own cgroup, because a profile taken inside
the agent container is a measurement of the agent cgroup, not of the machine
(#1054). Phases (cold start, warmed idle, load, suite) are separate runs with
a phase name; `report` prints them side by side.

Environment (so a result can be re-attributed to a tree): the compose
project, the git commit of the checkout the tool was run from when it is a
repository, the docker server version and the sampler cgroup's limit.

usage:
  scripts/stack_memory_profile sample --project NAME --phase NAME
      [--duration SECONDS | --during 'command ...'] [--interval SECONDS]
      [--out FILE]            append one JSON line per run to FILE
      (--duration together with --during caps the phase: a child that
      outlives the cap is terminated and reported as during_rc)
  scripts/stack_memory_profile report --in FILE
      print the phase table of the runs recorded in FILE

Both commands take --cgroup-root and --proc-root for the offline suite;
everything docker-related goes through run_docker(), which the suite stubs.
"""

import argparse
import datetime
from itertools import zip_longest
import json
import os
import subprocess
import sys
import time

CGROUP_ROOT = "/sys/fs/cgroup"
PROC_ROOT = "/proc"
DEFAULT_INTERVAL = 1.0
# the per-process /proc reads are the expensive part and answer a slower
# question: which process is the big one, not what it did in this second
DEFAULT_PROC_INTERVAL = 15.0

# the keys of memory.stat that separate the charge the way #1054 reads it:
# anon + kernel + unreclaimable slab is what cannot be taken back
STAT_KEYS = ("anon", "file", "kernel_stack", "slab_reclaimable",
             "slab_unreclaimable", "sock")


def read_int(path):
    """The integer a cgroup file holds, or None when absent/unreadable/max."""
    try:
        with open(path) as handle:
            text = handle.read().strip()
    except OSError:
        return None
    if text in ("max", ""):
        return None
    try:
        return int(text)
    except ValueError:
        return None


def parse_kv(text):
    """`key value` lines to a dict; broken lines are dropped, not fatal."""
    values = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) == 2:
            try:
                values[parts[0]] = int(parts[1])
            except ValueError:
                pass
    return values


def read_stat(path):
    try:
        with open(path) as handle:
            return parse_kv(handle.read())
    except OSError:
        return {}


def committed_bytes(stat):
    """The unreclaimable part of a memory.stat - what the charge really is."""
    return (stat.get("anon", 0) + stat.get("sock", 0)
            + stat.get("kernel_stack", 0) + stat.get("slab_unreclaimable", 0))


def percentile(values, fraction):
    """The element at `fraction` of the sorted values (peak = 1.0)."""
    if not values:
        return None
    ordered = sorted(values)
    index = min(len(ordered) - 1, int(round(fraction * (len(ordered) - 1))))
    return ordered[index]


def cgroup_path_of(pid, proc_root=PROC_ROOT):
    """The cgroup v2 path of a pid, or None when the process is gone."""
    try:
        with open(os.path.join(proc_root, str(pid), "cgroup")) as handle:
            for line in handle:
                # cgroup v2 is the unified "0::" line; v1 controllers are
                # irrelevant here and are skipped, not guessed
                fields = line.strip().split(":", 2)
                if len(fields) == 3 and fields[0] == "0" and fields[1] == "":
                    return fields[2]
    except OSError:
        pass
    return None


def self_cgroup_path(proc_root=PROC_ROOT):
    return cgroup_path_of(os.getpid(), proc_root=proc_root)


def run_docker(args, timeout=10):
    """`docker` with the timeout of #1054: a stuck daemon must not hang a
    profiling phase, and this tool has no business waiting for one."""
    try:
        return subprocess.run(["docker"] + args, capture_output=True,
                              text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None


def stack_containers(project):
    """[(name, pid)] of the project's RUNNING containers, by compose label."""
    result = run_docker(["ps", "-q", "--filter",
                         f"label=com.docker.compose.project={project}"])
    if result is None or result.returncode != 0:
        return []
    ids = [line for line in result.stdout.split() if line]
    listed = []
    for container_id in ids:
        info = run_docker(["inspect", "--format",
                           "{{.Name}}\t{{.State.Pid}}", container_id])
        if info is None or info.returncode != 0:
            continue
        try:
            name, pid = info.stdout.strip().split("\t")
            listed.append((name.lstrip("/"), int(pid)))
        except ValueError:
            continue
    return listed


def read_cgroup(path, cgroup_root=CGROUP_ROOT):
    """One cgroup's memory numbers; None when the path itself is absent."""
    directory = cgroup_root + path if path != "/" else cgroup_root
    current = read_int(os.path.join(directory, "memory.current"))
    if current is None and not os.path.isdir(directory):
        return None
    return {
        "current": current,
        "peak_file": read_int(os.path.join(directory, "memory.peak")),
        "limit": read_int(os.path.join(directory, "memory.max")),
        "stat": read_stat(os.path.join(directory, "memory.stat")),
        "events": read_stat(os.path.join(directory, "memory.events")),
        # cpu.stat of the same cgroup: usage_usec and the throttle counters
        # are cumulative, so the phase reports their delta
        "cpu": read_stat(os.path.join(directory, "cpu.stat")),
    }


def procs_of_cgroup(path, cgroup_root=CGROUP_ROOT):
    """The pids in one container's cgroup, including its child cgroups.

    Reading the cgroup is how #1054 says to find what belongs to a stack -
    it is the same truth the kernel charges memory by, and it costs one
    directory walk instead of a scan of the whole /proc.
    """
    directory = cgroup_root + path if path != "/" else cgroup_root
    pids = []
    stack = [directory]
    while stack:
        here = stack.pop()
        try:
            entries = os.listdir(here)
        except OSError:
            continue
        for entry in entries:
            if entry == "cgroup.procs":
                try:
                    with open(os.path.join(here, entry)) as handle:
                        for line in handle:
                            if line.strip().isdigit():
                                pids.append(int(line))
                except OSError:
                    pass
            elif os.path.isdir(os.path.join(here, entry)):
                stack.append(os.path.join(here, entry))
    return pids


def read_proc_status(pid, proc_root=PROC_ROOT):
    """VmRSS / RssAnon / RssFile / RssShmem of a pid, in bytes; None if gone.

    These four are what the acceptance of #1613 asks for at process level:
    the private anonymous part, the file-backed part, and the shared part -
    PostgreSQL's shared_buffers show up as RssShmem of every backend, which
    is how the shared/private split is answered without a per-kernel-page
    walk. Proportional Set Size would need /proc/<pid>/smaps_rollup, which
    an unprivileged agent container cannot read; the tool reports the gap
    instead of inventing a PSS.
    """
    try:
        with open(os.path.join(proc_root, str(pid), "status")) as handle:
            text = handle.read()
    except OSError:
        return None
    values = {}
    for line in text.splitlines():
        key, _, rest = line.partition(":")
        if key in ("VmRSS", "RssAnon", "RssFile", "RssShmem"):
            parts = rest.split()
            if parts and parts[0].isdigit():
                # status reports kB; the tool speaks bytes everywhere else
                values[key] = int(parts[0]) * 1024
    return values or None


def read_proc_comm(pid, proc_root=PROC_ROOT):
    """The command name of a pid (the ``comm`` field), or None when gone."""
    try:
        with open(os.path.join(proc_root, str(pid), "stat")) as handle:
            text = handle.read()
    except OSError:
        return None
    # comm is field 2 and may contain spaces and parentheses: take what is
    # between the first "(" and the last ")" instead of splitting blindly
    start, end = text.find("("), text.rfind(")")
    if start == -1 or end <= start:
        return None
    return text[start + 1:end]


def sample_processes(path, cgroup_root=CGROUP_ROOT, proc_root=PROC_ROOT):
    """Per command name: peak RSS and the anon/file/shared split, in bytes.

    Aggregated by command because a worker fleet is a dozen processes with
    one name, and a phase is interested in the biggest consumer, not in a
    pid list that changes between samples.
    """
    by_comm = {}
    for pid in procs_of_cgroup(path, cgroup_root=cgroup_root):
        status = read_proc_status(pid, proc_root=proc_root)
        if status is None:
            continue
        comm = read_proc_comm(pid, proc_root=proc_root) or "?"
        row = by_comm.setdefault(comm, {"processes": 0, "vmrss_peak": 0,
                                        "anon": 0, "file": 0, "shmem": 0})
        row["processes"] += 1
        row["vmrss_peak"] = max(row["vmrss_peak"], status.get("VmRSS", 0))
        # the sums are the per-sample totals; the caller keeps the maximum
        # over the phase, so a backend that grew is not double counted
        row["anon"] += status.get("RssAnon", 0)
        row["file"] += status.get("RssFile", 0)
        row["shmem"] += status.get("RssShmem", 0)
    return by_comm


def split_stat(stat):
    """The stat keys this tool reports, 0 for absent ones (never invented)."""
    return {key: stat.get(key, 0) for key in STAT_KEYS}


class Sampler:
    """Collects one phase: repeated reads of every container + own cgroup."""

    def __init__(self, project, phase, interval=DEFAULT_INTERVAL,
                 proc_interval=DEFAULT_PROC_INTERVAL,
                 cgroup_root=CGROUP_ROOT, proc_root=PROC_ROOT):
        self.project = project
        self.phase = phase
        self.interval = interval
        self.refresh_every = max(1, int(5 / interval)) if interval else 5
        # /proc reads of every process of every container are the expensive
        # part of a sample, so they run on their own (coarse) cadence
        self.proc_every = max(1, int(round(proc_interval / interval))) \
            if interval else 1
        self.cgroup_root = cgroup_root
        self.proc_root = proc_root
        self.containers = {}   # name -> {"paths": [readings]}
        self.self_readings = []
        self.samples = 0
        self.proc_samples = 0
        self.events_first = {}
        self.events_last = {}
        self.cpu_first = {}
        self.cpu_last = {}
        self.procs = {}
        self.lost_containers = []

    def container_paths(self):
        """Refresh the container -> cgroup path map (started containers)."""
        paths = {}
        for name, pid in stack_containers(self.project):
            path = cgroup_path_of(pid, proc_root=self.proc_root)
            if path is None:
                self.lost_containers.append(name)
                continue
            paths[name] = path
        return paths

    def take_sample(self, paths):
        self.samples += 1
        # the /proc walk of every process is the expensive read, so it runs
        # on its own coarse cadence instead of every memory sample
        with_procs = (self.samples - 1) % self.proc_every == 0
        if with_procs:
            self.proc_samples += 1
        for name, path in paths.items():
            reading = read_cgroup(path, cgroup_root=self.cgroup_root)
            if reading is None:
                continue
            bucket = self.containers.setdefault(
                name, {"current": [], "anon": [], "file": [], "committed": [],
                       "peak_file_max": None, "path": path})
            bucket["current"].append(reading["current"])
            stat = split_stat(reading["stat"])
            bucket["anon"].append(stat["anon"])
            bucket["file"].append(stat["file"])
            bucket["committed"].append(committed_bytes(reading["stat"]))
            if reading["peak_file"] is not None:
                current_max = bucket["peak_file_max"]
                bucket["peak_file_max"] = max(
                    [v for v in (current_max, reading["peak_file"])
                     if v is not None])
            events = reading["events"]
            if name not in self.events_first:
                self.events_first[name] = events
            self.events_last[name] = events
            # cpu.stat is cumulative like memory.events: what a phase used is
            # the delta, never the lifetime value
            cpu = reading["cpu"]
            if name not in self.cpu_first:
                self.cpu_first[name] = cpu
            self.cpu_last[name] = cpu
            if with_procs:
                self.merge_procs(name, sample_processes(
                    path, cgroup_root=self.cgroup_root,
                    proc_root=self.proc_root))
        self_read = read_cgroup(self_cgroup_path(proc_root=self.proc_root) or "/",
                                cgroup_root=self.cgroup_root)
        if self_read is not None:
            self.self_readings.append(self_read)

    def merge_procs(self, name, by_comm):
        """Keep, per container and command name, the peak over the phase."""
        kept = self.procs.setdefault(name, {})
        for comm, row in by_comm.items():
            old = kept.get(comm)
            if old is None:
                kept[comm] = dict(row)
                continue
            old["processes"] = max(old["processes"], row["processes"])
            old["vmrss_peak"] = max(old["vmrss_peak"], row["vmrss_peak"])
            old["anon"] = max(old["anon"], row["anon"])
            old["file"] = max(old["file"], row["file"])
            old["shmem"] = max(old["shmem"], row["shmem"])

    def run(self, duration=None, during=None):
        """Sample until `duration` seconds passed, or the `during` child ends."""
        paths = self.container_paths()
        started = time.monotonic()
        child = None
        child_rc = None
        if during:
            child = subprocess.Popen(during, shell=True)
        try:
            while True:
                self.take_sample(paths)
                timed_out = (duration is not None
                             and time.monotonic() - started >= duration)
                if child is not None and child.poll() is not None:
                    child_rc = child.returncode
                    break
                if child is None and timed_out:
                    break
                if child is not None and timed_out:
                    # the --duration of a --during phase is a safety cap:
                    # a phase that never ends is a broken phase, not a
                    # long one, and the sampler must not outlive it
                    child_rc = "duration-cap"
                    break
                # a cold start phase samples containers that only appear
                # while it runs: re-list every few samples
                if self.samples % self.refresh_every == 0:
                    paths = self.container_paths()
                time.sleep(self.interval)
        finally:
            if child is not None and child.poll() is None:
                child.terminate()
                child_rc = "terminated"
        self.elapsed = time.monotonic() - started
        self.child_rc = child_rc
        # one final refresh so containers that appeared mid-phase count
        self.take_sample(self.container_paths())
        return self.report(during=during)

    def report(self, during=None):
        containers = {}
        for name, bucket in sorted(self.containers.items()):
            peak = percentile(bucket["current"], 1.0)
            committed_peak = percentile(bucket["committed"], 1.0)
            first_events = self.events_first.get(name, {})
            last_events = self.events_last.get(name, {})
            containers[name] = {
                "cgroup": bucket["path"],
                "samples": len(bucket["current"]),
                "current_p50": percentile(bucket["current"], 0.5),
                "current_peak": peak,
                # the kernel's own high watermark survives a restart of the
                # sampling; when present it is the honest peak
                "peak_file": bucket["peak_file_max"],
                "anon_p50": percentile(bucket["anon"], 0.5),
                "file_p50": percentile(bucket["file"], 0.5),
                "committed_p50": percentile(bucket["committed"], 0.5),
                "committed_peak": committed_peak,
                "oom_delta": last_events.get("oom", 0) - first_events.get("oom", 0),
                "oom_kill_delta": (last_events.get("oom_kill", 0)
                                   - first_events.get("oom_kill", 0)),
                "cpu_usage_usec_delta": (self.cpu_last.get(name, {}).get("usage_usec", 0)
                                         - self.cpu_first.get(name, {}).get("usage_usec", 0)),
                "cpu_throttled_usec_delta": (
                    self.cpu_last.get(name, {}).get("throttled_usec", 0)
                    - self.cpu_first.get(name, {}).get("throttled_usec", 0)),
                # {} in runs recorded before process sampling existed
                "procs": dict(sorted(self.procs.get(name, {}).items(),
                                     key=lambda kv: -kv[1]["vmrss_peak"])),
            }
        # the stack sums are per sample instant; containers that joined
        # mid-phase contribute from their first sample on (zip_longest),
        # so a short bucket never truncates the total
        totals_current = [sum(v for v in column if v is not None)
                          for column in zip_longest(
                              *(b["current"] for b in self.containers.values()))] \
            if self.containers else []
        totals_committed = [sum(v for v in column if v is not None)
                            for column in zip_longest(
                                *(b["committed"] for b in self.containers.values()))] \
            if self.containers else []
        self_report = None
        if self.self_readings:
            self_report = {
                "current_p50": percentile([r["current"] for r in self.self_readings], 0.5),
                "current_peak": percentile([r["current"] for r in self.self_readings], 1.0),
                "committed_p50": percentile([committed_bytes(r["stat"]) for r in self.self_readings], 0.5),
                "committed_peak": percentile([committed_bytes(r["stat"]) for r in self.self_readings], 1.0),
                "limit": self.self_readings[0]["limit"],
            }
        return {
            "project": self.project,
            "phase": self.phase,
            "at": datetime.datetime.now(datetime.timezone.utc)
                  .isoformat(timespec="seconds"),
            "interval_seconds": self.interval,
            "samples": self.samples,
            "proc_samples": self.proc_samples,
            "elapsed_seconds": round(self.elapsed, 1) if hasattr(self, "elapsed") else None,
            "during": during,
            "during_rc": getattr(self, "child_rc", None),
            "containers": containers,
            "stack_sum_current_p50": percentile(totals_current, 0.5),
            "stack_sum_current_peak": percentile(totals_current, 1.0),
            "stack_sum_committed_p50": percentile(totals_committed, 0.5),
            "stack_sum_committed_peak": percentile(totals_committed, 1.0),
            "sampler_cgroup": self_report,
            "environment": environment(self.project),
            "lost_containers": sorted(set(self.lost_containers)),
        }


def environment(project):
    """What a reader needs to attribute the numbers to a tree and a host."""
    env = {
        "project": project,
        "git_commit": None,
        "docker": None,
        "kernel": os.uname().release,
    }
    try:
        env["git_commit"] = subprocess.run(
            ["git", "rev-parse", "--short", "HEAD"], capture_output=True,
            text=True, timeout=5).stdout.strip() or None
    except (OSError, subprocess.SubprocessError):
        pass
    result = run_docker(["version", "--format", "{{.Server.Version}}"])
    if result is not None and result.returncode == 0:
        env["docker"] = result.stdout.strip()
    return env


def cmd_sample(args):
    sampler = Sampler(args.project, args.phase, interval=args.interval,
                      proc_interval=args.proc_interval,
                      cgroup_root=args.cgroup_root, proc_root=args.proc_root)
    if args.during is None and args.duration is None:
        die("sample needs --duration or --during (what else should end the phase?)")
    report = sampler.run(duration=args.duration, during=args.during)
    text = json.dumps(report, sort_keys=True)
    if args.out:
        with open(args.out, "a") as handle:
            handle.write(text + "\n")
        print(f"phase {args.phase}: {report['samples']} samples -> {args.out}")
    else:
        print(text)
    return 0


def fmt_mb(value):
    return "-" if value is None else f"{value / (1024 * 1024):.0f}M"


def cmd_report(args):
    with open(args.infile) as handle:
        runs = [json.loads(line) for line in handle if line.strip()]
    env = runs[-1]["environment"] if runs else {}
    print(f"runs: {len(runs)}  project: {env.get('project')}  "
          f"commit: {env.get('git_commit')}  kernel: {env.get('kernel')}")
    for run in runs:
        child = f"  during: {run['during']} (rc={run['during_rc']})" if run.get("during") else ""
        self_cgroup = run.get("sampler_cgroup") or {}
        print(f"\n== {run['phase']}  ({run['samples']} samples, "
              f"{run.get('elapsed_seconds')}s)  "
              f"sum p50 {fmt_mb(run['stack_sum_current_p50'])} "
              f"peak {fmt_mb(run['stack_sum_current_peak'])}  "
              f"committed p50 {fmt_mb(run['stack_sum_committed_p50'])} "
              f"peak {fmt_mb(run['stack_sum_committed_peak'])}{child}")
        if self_cgroup:
            print(f"   sampler cgroup: p50 {fmt_mb(self_cgroup.get('current_p50'))} "
                  f"peak {fmt_mb(self_cgroup.get('current_peak'))} "
                  f"(limit {fmt_mb(self_cgroup.get('limit'))}, "
                  f"committed peak {fmt_mb(self_cgroup.get('committed_peak'))})")
        elapsed = run.get("elapsed_seconds")
        for name, numbers in sorted(run["containers"].items()):
            oom = (f" oom+{numbers['oom_delta']}/{numbers['oom_kill_delta']}"
                   if numbers["oom_delta"] or numbers["oom_kill_delta"] else "")
            peak_file = (f" file-peak {fmt_mb(numbers['peak_file'])}"
                         if numbers.get("peak_file") is not None else "")
            cpu = ""
            usage = numbers.get("cpu_usage_usec_delta")
            if usage and elapsed:
                cpu = f"  cpu {usage / (elapsed * 1e6):.2f} cores"
                throttled = numbers.get("cpu_throttled_usec_delta") or 0
                if throttled:
                    cpu += f" (throttled {throttled / 1e6:.1f}s)"
            print(f"   {name:<45} cur p50 {fmt_mb(numbers['current_p50']):>7}"
                  f"  peak {fmt_mb(numbers['current_peak']):>7}{peak_file}"
                  f"  anon p50 {fmt_mb(numbers['anon_p50']):>7}"
                  f"  committed peak {fmt_mb(numbers['committed_peak']):>7}{oom}{cpu}")
            # the process view answers "who inside this container" and, for
            # PostgreSQL, what part of its RSS is the shared segment
            for comm, row in list(numbers.get("procs", {}).items())[:args.procs]:
                print(f"       {'':<44} {comm} x{row['processes']}"
                      f"  rss peak {fmt_mb(row['vmrss_peak']):>7}"
                      f"  anon {fmt_mb(row['anon']):>7}"
                      f"  file {fmt_mb(row['file']):>7}"
                      f"  shmem {fmt_mb(row['shmem']):>7}")
    return 0


def die(message):
    print(f"stack_memory_profile: {message}", file=sys.stderr)
    sys.exit(1)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    sample = sub.add_parser("sample", help="sample one phase")
    sample.add_argument("--project", default=os.environ.get("COMPOSE_PROJECT_NAME"))
    sample.add_argument("--phase", required=True)
    sample.add_argument("--duration", type=float)
    sample.add_argument("--during")
    sample.add_argument("--interval", type=float, default=DEFAULT_INTERVAL)
    sample.add_argument("--proc-interval", type=float,
                        default=DEFAULT_PROC_INTERVAL,
                        help="seconds between per-process /proc reads")
    sample.add_argument("--out")
    sample.add_argument("--cgroup-root", default=CGROUP_ROOT)
    sample.add_argument("--proc-root", default=PROC_ROOT)
    report = sub.add_parser("report", help="print the runs of one --out file")
    report.add_argument("--in", dest="infile", required=True)
    report.add_argument("--procs", type=int, default=3,
                        help="process rows to show per container (0 = none)")
    args = parser.parse_args(argv)
    if args.cmd == "sample":
        if not args.project:
            die("sample needs --project (or COMPOSE_PROJECT_NAME)")
        return cmd_sample(args)
    return cmd_report(args)


if __name__ == "__main__":
    sys.exit(main())
