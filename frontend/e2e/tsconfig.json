{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["playwright.config.ts", "helpers/**/*.ts", "specs/**/*.ts", "steps/**/*.ts", "support/**/*.ts"],
  "exclude": ["node_modules", ".features-gen", ".output", "cucumber-report"]
}
