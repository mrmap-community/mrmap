# MrMap agent supervisor - the user-level service.
#
# User level, not system level, on purpose: the workers this daemon starts
# inherit the operator's OpenCode authentication and the host's `gh` (often a
# keyring-backed credential), and both live in the operator's home. A system
# service running as root reaches neither without weakening them, and "the
# supervisor can start workers" must not require root.
#
# Install (as the operator account that owns the gh login and the state dir):
#
#   mkdir -p ~/.config/systemd/user
#   cp scripts/systemd/mrmap-agent-supervisor.service ~/.config/systemd/user/
#   # edit the three paths below to this host:
#   #   ExecStart, WorkingDirectory, Environment=MRMAP_SUPERVISOR_CONFIG
#   systemctl --user daemon-reload
#   systemctl --user enable --now mrmap-agent-supervisor
#   loginctl enable-linger $USER        # keep it running across logout/reboot
#
# The daemon refuses to double: a second start against the same state directory
# exits 3, so an enablement mistake cannot schedule an issue twice.
#
# If this host has no systemd user instance (a container without linger), the
# same loop runs under `scripts/agent-supervisor daemon start`, which detaches
# itself the same way and writes the same log.

[Unit]
Description=MrMap OpenCode agent supervisor (approval gate, scheduler, watchers)
Documentation=https://github.com/mrmap-community/mrmap/blob/master/docs/source/development/agent-supervisor.rst
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# The checkout the supervisor and the workers' worktrees branch from, and the
# protected configuration outside it. Keep the config out of any directory a
# worker can write.
Environment=MRMAP_SUPERVISOR_CONFIG=%h/.config/mrmap-agent-supervisor/config.json
WorkingDirectory=%h/src/mrmap
ExecStart=%h/src/mrmap/scripts/agent-supervisor run
Restart=always
RestartSec=60
# A daemon that comes back 5 times in 10 minutes is meeting something it cannot
# fix (exit 3 means a second supervisor is configured somewhere); stop hammering
# and leave the last state in the log for the operator.
StartLimitIntervalSec=600
StartLimitBurst=5

# The workers outlive the supervisor, by design. They run in their own session
# (the runner starts them with a new process group), but under systemd they
# still sit in this unit's cgroup - KillMode=process is what keeps
# `systemctl --user stop` from taking a forty-minute agent run down with it.
# The next start adopts the survivors through reconcile, the same path a
# reboot takes.
KillMode=process
KillSignal=SIGTERM
# The current tick must be allowed to finish its stage: plan, watch CI, watch
# review. Generous, because one GitHub pass over several pull requests is
# minutes, and a KILLed tick loses the ledger writes that keep it from asking
# the same question twice.
TimeoutStopSec=180

# Modest for a supervisor; the ceiling that actually matters is the one the
# host-level capacity gate measures before each start. MemoryMax here would
# only stop the supervisor itself, never its workers - if you are tempted to
# set it, the knob you want is the agent container's limit
# (docs/source/development/agent-capacity.rst).
# MemoryMax=512M

NoNewPrivileges=true
PrivateTmp=true

[Install]
# with enable + linger; WantedBy=default.target is the user-level equivalent
WantedBy=default.target
