msgstr "Id des Harvesting-Laufs, für den die Zeile geschrieben wurde."

#: registry/filters/harvesting.py:129
msgid "Comma separated ids of harvesting runs."
msgstr "Kommagetrennte Ids von Harvesting-Läufen."

#: registry/filters/harvesting.py:132
msgid "Exact log level: 0 fatal, 1 error, 2 warning, 3 info, 4 debug."
msgstr "Exakte Protokollebene: 0 Fatal, 1 Fehler, 2 Warnung, 3 Info, 4 Debug."

#: registry/filters/harvesting.py:136
msgid ""
"Lines of this level and worse; the levels count from fatal, so 2 answers "
