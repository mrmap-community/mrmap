      "Rollout",
      "Rollback and upgrade",
      "Evidence and open risks"
    ]
  },
  "authority": {
    "admission": "scripts/agent_capacity",
    "admission_never_overridden_by": "this page, the runbook or any number in this file",
    "matrix_checker": "scripts/compose_profiles_smoke.py",
    "sampler": "scripts/stack_memory_profile",
    "web_bench": "scripts/http_process_bench.py"
  },
  "modes": [
    {
      "id": "full",
      "compose_files": ["docker-compose.yml"],
      "profiles": [],
      "web_shape": "4 workers x 4 threads HTTP, 1 ASGI websocket worker, preload off",
      "pool_bounds": "4 reserved / 20 open per pooled process",
      "is_contract": true,
      "note": "the documented deployment contract of docs/source/installation/index.rst - unchanged by epic #1612, including the log store, both operator UIs and the cold-start wait on victoria-logs"
    },
    {
      "id": "lightweight",
      "compose_files": ["docker-compose.yml", "docker-compose.lightweight.yml"],
      "profiles": ["observability", "admin", "testing"],
      "web_shape": "same as full unless the mode below is set",
      "pool_bounds": "same as full unless the mode below is set",
      "is_contract": false,
      "note": "opt-in layer, applied LAST; profiles are opt-in so an inactive tier is never created, never restarted after a reboot and publishes no host port"
    },
    {
      "id": "low-memory-web-tier",
      "compose_files": ["docker-compose.yml", "docker-compose.lightweight.yml"],
      "profiles": [],
      "env": {"MRMAP_LOW_MEMORY": "1"},
      "web_shape": "1 worker x 2 threads HTTP, 1 ASGI websocket worker, preload off",
      "pool_bounds": "1 reserved / 4 open per pooled process",
      "is_contract": false,
      "note": "one variable moves the web shape and the pool bounds together (#1617 and #1621 read the same mode); an explicit GUNICORN_* or *_BACKEND_RESERVED_CONNECTIONS value always wins over the mode"
    },
    {
      "id": "test-concurrency",
      "compose_files": ["docker-compose.yml", "docker-compose.dev.yml", "docker-compose.prebuilt.yml", "docker-compose.lightweight.yml", "docker-compose.test-low-memory.yml"],
      "profiles": ["testing"],
      "env": {"MRMAP_TEST_WORKERS": "1"},
      "web_shape": "not a deployment mode - test containers only",
      "pool_bounds": "not a deployment mode - test containers only",
      "is_contract": false,
      "note": "the #1619 preset limits the test runners to one worker; it changes no pool, heap, database or production setting and does not waive the admission gate"
    }
  ],
  "tiers": {
    "observability": ["victoria-logs", "grafana"],
    "admin": ["pgadmin", "flower"],
    "testing": ["pre-commit-check", "behave", "django-tests", "frontend-tests"]
  },
  "core_services": ["postgis", "redis", "docker-api", "backend", "celery-worker", "celery-beat", "frontend"],
  "knobs": [
