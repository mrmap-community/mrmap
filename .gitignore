# ---> Python
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
**/coverage/
/frontend/dist/
.tox/
**/.coverage
**/.coverage.*
**/.cache
**/*coverage-report.xml
**/*coverage-report.json

# release gates (#1583): candidate document and verdicts CI generates, never committed
backend/openapi-candidate.json
release-api.json
release-version.json
release-upgrade.json

# Django stuff:
*.log
local_settings.py
.noseids

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# SageMath parsed files
*.sage.py

# virtualenv
.venv
venv/
ENV/

# sphinx builded docs
/docs/build/

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

# Pycharm
.idea

# Sonar
.scannerwork/


mrmap/media/**

**/node_modules/


# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

/backend/media
/.env
# local per-host OpenCode MCP overrides (dev-only DSN) - never commit;
# the project skills in .opencode/skills are tracked deliverables
/.opencode/*
!/.opencode/skills/

# runtime benchmark run directories (#1396) - what scripts/task_perf_runner.sh
# writes from inside the test container; the report belongs in a CI artifact,
# never in the repository. Under backend/ because that is the container's bind
# mount, so the artifact path of the nightly and this ignore are one path.
/backend/task-perf/
/backend/task-perf-heavy/

# run directories of the observability benchmark (#1777) - the workload files
# of a celery cell and the staged load driver of an http cell, both written
# below backend/ for the same reason as above: it is the container's bind
# mount. Nothing here is evidence; the evidence is --out.
/backend/observability-bench/
